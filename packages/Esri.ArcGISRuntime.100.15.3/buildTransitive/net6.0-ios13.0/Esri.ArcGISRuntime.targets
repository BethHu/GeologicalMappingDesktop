<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="AGSRuntimePreviewWarning" BeforeTargets="ResolveAssemblyReferences;Build;Rebuild">
      <Warning Code="ESRI8000" Text="Targeting '$(TargetFramework)' with 'Esri.ArcGISRuntime' is currently in preview and not fully supported." />
  </Target>
  <ItemGroup Condition="'$(DesignTimeBuild)' != 'true' AND '$(DeployArcGISNetworkAnalystResources)'!='false'">
    <Content Include="$(MSBuildThisFileDirectory)..\..\resources\network_analyst\strings.bin" Visible="false">
      <Link>RuntimeCoreNet\resources\network_analyst\strings.bin</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
</Project>
