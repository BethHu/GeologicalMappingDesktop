<Window x:Class="GeologicalMappingDesktop.CloudSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录" Height="340" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0D1117" Foreground="#C9D1D9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- User Info Bar (shown after login) -->
        <Border x:Name="UserInfoBar" Grid.Row="0" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TxtLoggedInUser" FontSize="14" Foreground="#58A6FF" FontWeight="Bold"/>
                <TextBlock x:Name="TxtLoggedInStatus" FontSize="11" Foreground="#8B949E" Text="点击下方退出按钮切换账号"/>
            </StackPanel>
        </Border>

        <!-- Login form (hidden after login) -->
        <StackPanel x:Name="LoginForm" Grid.Row="1">
            <TextBlock Text="服务器地址" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtServerUrl" Text="http://localhost:3580"
                     Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D"
                     Padding="8" FontSize="13" Margin="0,0,0,10"/>
            <TextBlock Text="用户名" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Background="#21262D" Foreground="#C9D1D9"
                     BorderBrush="#30363D" Padding="8" FontSize="13" Margin="0,0,0,6"/>
            <TextBlock Text="密码" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Background="#21262D" Foreground="#C9D1D9"
                         BorderBrush="#30363D" Padding="8" FontSize="13" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="BtnLogin" Content="登录" Width="90" Height="32"
                    Background="#238636" Foreground="White" BorderBrush="#2EA043"
                    Margin="0,0,6,0" Click="BtnLogin_Click"/>
            <Button x:Name="BtnRegister" Content="注册" Width="90" Height="32"
                    Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D"
                    Margin="0,0,6,0" Click="BtnRegister_Click"/>
            <Button x:Name="BtnLogout" Content="退出登录" Width="90" Height="32"
                    Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D"
                    Margin="0,0,0,0" Click="BtnLogout_Click" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Status -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtStatus" Text="请登录或注册账号" Foreground="#8B949E"
                       FontSize="12" TextWrapping="Wrap"/>
        </ScrollViewer>
    </Grid>
</Window>
