<Window x:Class="GeologicalMappingDesktop.NewFeatureLayerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建要素图层" Height="400" Width="290.308"
        WindowStartupLocation="CenterOwner"
        Background="#161B22"
        MinHeight="380" MinWidth="360"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 图层名称标签 -->
            <RowDefinition Height="Auto"/>
            <!-- 图层名称输入框 -->
            <RowDefinition Height="Auto"/>
            <!-- 间距 -->
            <RowDefinition Height="Auto"/>
            <!-- 几何类型标签 -->
            <RowDefinition Height="Auto"/>
            <!-- 几何类型下拉框 -->
            <RowDefinition Height="Auto"/>
            <!-- 间距 -->
            <RowDefinition Height="Auto"/>
            <!-- 坐标系标签 -->
            <RowDefinition Height="Auto"/>
            <!-- 坐标系下拉框 -->
            <RowDefinition Height="*"/>
            <!-- 弹性撑满 -->
            <RowDefinition Height="Auto"/>
            <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- 1. 图层名称 -->
        <TextBlock Grid.Row="0" Text="图层名称" Foreground="#E6EDF3" FontSize="13" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtLayerName" Grid.Row="1" Text="新建图层" Height="30" 
                 Foreground="#E6EDF3" Background="#21262D" 
                 BorderBrush="#30363D" BorderThickness="1" Padding="6,4"/>

        <!-- 2. 几何类型 -->
        <TextBlock Grid.Row="2" Text="几何类型" Foreground="#E6EDF3" FontSize="13" Margin="0,12,0,4"/>
        <ComboBox x:Name="CboGeometryType" Grid.Row="3" Height="30" 
                  Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                  Foreground="#E6EDF3" SelectionChanged="CboGeometryType_SelectionChanged">
            <ComboBoxItem Content="点 (Point)" Tag="Point" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="线 (Polyline)" Tag="Polyline" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="面 (Polygon)" Tag="Polygon" Background="#21262D" Foreground="#E6EDF3"/>
        </ComboBox>

        <!-- 3. 单元类型（仅面图层启用） -->
        <TextBlock Grid.Row="4" Text="单元类型（面图层）" Foreground="#E6EDF3" FontSize="13" Margin="0,12,0,4"/>
        <ComboBox x:Name="CboUnitType" Grid.Row="5" Height="30" 
                  Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                  Foreground="#E6EDF3" SelectionChanged="CboUnitType_SelectionChanged">
            <ComboBoxItem Content="普通面图层" Tag="" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="地层单元（名称/代号/岩性）" Tag="STRATUM" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="岩体单元（名称/代号/岩性）" Tag="ROCK" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="构造单元（名称/代号/岩性）" Tag="TECTONIC" Background="#21262D" Foreground="#E6EDF3"/>
        </ComboBox>

        <!-- 4. 坐标系 -->
        <TextBlock Grid.Row="6" Text="坐标系" Foreground="#E6EDF3" FontSize="13" Margin="0,12,0,4"/>
        <ComboBox x:Name="CboSpatialReference" Grid.Row="7" Height="30" 
                  Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                  Foreground="#E6EDF3">
            <ComboBoxItem Content="WGS84 (EPSG:4326)" Tag="4326" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="CGCS2000 (EPSG:4490)" Tag="4490" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="UTM Zone 50N (EPSG:32650)" Tag="32650" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="UTM Zone 51N (EPSG:32651)" Tag="32651" Background="#21262D" Foreground="#E6EDF3"/>
            <ComboBoxItem Content="Web Mercator (EPSG:3857)" Tag="3857" Background="#21262D" Foreground="#E6EDF3"/>
        </ComboBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消" Width="80" Height="30" Margin="0,0,8,0"
                    Click="BtnCancel_Click"
                    Background="Transparent" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="8,4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="BtnOK" Content="确定" Width="80" Height="30"
                    Click="BtnOK_Click"
                    Background="#238636" Foreground="White" BorderBrush="#238636" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="8,4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EA043"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>