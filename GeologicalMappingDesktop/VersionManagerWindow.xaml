<Window x:Class="GeologicalMappingDesktop.VersionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本管理" Height="580" Width="780"
        FontFamily="Microsoft YaHei"
        Background="#0D1117"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#21262D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6FEB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#30363D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#484F58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#DA3633"/>
            <Setter Property="BorderBrush" Value="#F85149"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#30363D" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 左侧：版本列表 -->
            <Border Grid.Column="0" Grid.Row="0" BorderBrush="#30363D" BorderThickness="0,0,1,0" Background="#161B22">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="历史版本" Foreground="#8B949E" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="VersionList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             SelectionMode="Extended"
                             SelectionChanged="VersionList_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#8B949E" FontSize="10"/>
                                    <TextBlock Text="{Binding Creator}" Foreground="#58A6FF" FontSize="10"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#8B949E" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Grid.Row="0" Width="4" Background="#21262D" HorizontalAlignment="Stretch"/>

            <!-- 右侧：详情 / 对比 -->
            <Grid Grid.Column="2" Grid.Row="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 模式切换 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="RdoDetail" Content="版本详情" Foreground="#E6EDF3" FontSize="12"
                                 IsChecked="True" GroupName="ViewMode" Margin="0,0,16,0"/>
                    <RadioButton x:Name="RdoCompare" Content="版本对比" Foreground="#E6EDF3" FontSize="12"
                                 GroupName="ViewMode"/>
                </StackPanel>

                <!-- 详情模式 -->
                <StackPanel x:Name="DetailPanel" Grid.Row="1" Visibility="Visible">
                    <TextBlock x:Name="TxtVersionName" Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtVersionMeta" Foreground="#8B949E" FontSize="11" Margin="0,2,0,4"/>
                    <TextBlock x:Name="TxtVersionDesc" Foreground="#E6EDF3" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 对比模式 -->
                <StackPanel x:Name="ComparePanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmpVersionA" Grid.Column="0" Height="26" Background="#21262D"
                                  Foreground="#E6EDF3" BorderBrush="#30363D" DisplayMemberPath="Name"/>
                        <TextBlock Grid.Column="1" Text="  ↔  " Foreground="#8B949E" FontSize="14" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmpVersionB" Grid.Column="2" Height="26" Background="#21262D"
                                  Foreground="#E6EDF3" BorderBrush="#30363D" DisplayMemberPath="Name"/>
                    </Grid>
                    <Button x:Name="BtnRunCompare" Content="执行对比" Style="{StaticResource PrimaryBtn}" Height="26"
                            Padding="8,0" HorizontalAlignment="Left" Click="BtnRunCompare_Click"/>
                </StackPanel>

                <!-- 结果区域 -->
                <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtResultHeader" Grid.Row="0" Foreground="#8B949E" FontSize="11" Margin="0,0,0,4"/>
                        <ScrollViewer x:Name="ResultScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ResultList" Background="Transparent" BorderThickness="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="4,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="11"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#8B949E" FontSize="10" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部按钮 -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                    Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0"
                    Padding="8,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSaveVersion" Content="保存版本" Style="{StaticResource PrimaryBtn}" Click="BtnSaveVersion_Click"/>
                    <Button x:Name="BtnRollback" Content="回滚到此版本" Style="{StaticResource DangerBtn}" Click="BtnRollback_Click"/>
                    <Button x:Name="BtnClose" Content="关闭" Style="{StaticResource ToolBtn}" Click="BtnClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
