<Window x:Class="GeologicalMappingDesktop.SampleListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="样品清单" Height="550" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        FontFamily="Microsoft YaHei"
        MinWidth="500" MinHeight="350">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="样品台账" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DataGrid x:Name="SampleGrid" Grid.Row="1"
                          Background="#0D1117" Foreground="#E6EDF3"
                          BorderBrush="#30363D" BorderThickness="0"
                          RowBackground="#161B22" AlternatingRowBackground="#1C2128"
                          GridLinesVisibility="Horizontal"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          FontSize="11"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnExportCsv" Content="导出 CSV" Width="90" Height="30" Margin="4"
                    Background="#238636" Foreground="White" BorderBrush="#2EA043" BorderThickness="1" Click="BtnExportCsv_Click"/>
            <Button x:Name="BtnExportExcel" Content="导出 Excel" Width="90" Height="30" Margin="4"
                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnExportExcel_Click"/>
            <Button x:Name="BtnClose" Content="关闭" Width="70" Height="30" Margin="4"
                    Background="Transparent" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
