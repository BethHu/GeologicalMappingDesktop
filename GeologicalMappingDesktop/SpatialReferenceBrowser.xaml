<Window x:Class="GeologicalMappingDesktop.SpatialReferenceBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择坐标系" Height="600" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        FontFamily="Microsoft YaHei"
        Foreground="#E6EDF3"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow"
                                  Data="M0,0 L6,5 L0,10 Z"
                                  Fill="#8B949E"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  Background="Transparent"
                                                  Width="16" Height="16"
                                                  Margin="2,0,4,0"/>
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6FEB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="搜索坐标系:" FontSize="12" Foreground="#8B949E"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSearch" Grid.Column="1" Height="28"
                         VerticalContentAlignment="Center"
                         Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3"
                         BorderThickness="1" FontSize="12"
                         TextChanged="TxtSearch_TextChanged"/>
                <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="28" Height="28"
                        Background="#21262D" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1"
                        FontSize="12" Margin="4,0,0,0" Click="BtnClearSearch_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="坐标系列表" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                    </Border>
                    <TreeView x:Name="TreeSrs" Grid.Row="1"
                              Background="#161B22" BorderThickness="0"
                              Foreground="#E6EDF3" FontSize="13"
                              SelectedItemChanged="TreeSrs_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Header}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Foreground}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItemStyle}"/>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="坐标系信息" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                    </Border>

                    <Border Grid.Row="1" Padding="8,6" Background="#21262D" Margin="4,4,4,0" CornerRadius="4">
                        <StackPanel>
                            <TextBlock x:Name="TxtSrName" Text="(未选择)" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtSrWkid" Text="" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Padding="8,4" Margin="4,4,4,0">
                        <StackPanel>
                            <TextBlock Text="自定义 EPSG" FontSize="12" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="EPSG:" FontSize="12" Foreground="#E6EDF3"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtCustomEpsg" Grid.Column="1" Height="26"
                                         VerticalContentAlignment="Center"
                                         Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3"
                                         BorderThickness="1" FontSize="12"
                                         TextChanged="TxtCustomEpsg_TextChanged"/>
                                <Button x:Name="BtnApplyCustom" Grid.Column="2" Content="应用" Width="50" Height="26"
                                        Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1"
                                        FontSize="12" Margin="4,0,0,0" IsEnabled="False"
                                        Click="BtnApplyCustom_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtCustomStatus" Text="" FontSize="11" Foreground="#DA3633" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Margin="4,4,4,4" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="WKT 预览" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4"/>
                            <Border Grid.Row="1" BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Background="#0D1117">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtWktPreview" Text="" FontSize="10" Foreground="#8B949E"
                                               FontFamily="Consolas" TextWrapping="Wrap" Padding="4"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
            <TextBlock x:Name="TxtSelectionSummary" Text="当前选择：WGS84 (EPSG:4326)"
                       FontSize="12" Foreground="#58A6FF" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnOK" Content="确定" Width="90" Height="32"
                    Background="#238636" Foreground="White" BorderThickness="0"
                    Click="BtnOK_Click" Margin="0,0,8,0" FontSize="13" Cursor="Hand"/>
            <Button x:Name="BtnCancel" Content="取消" Width="80" Height="32"
                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1"
                    Click="BtnCancel_Click" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
