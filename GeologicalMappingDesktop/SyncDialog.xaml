<Window x:Class="GeologicalMappingDesktop.SyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据同步" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#21262D" CornerRadius="8" Padding="16" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="同步模式" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RdoServerMode" Content="作为服务器（等待移动端连接）" 
                             IsChecked="True" Foreground="#E6EDF3" FontSize="13" Margin="0,0,0,8"
                             GroupName="SyncMode"/>
                <RadioButton x:Name="RdoClientMode" Content="作为客户端（连接桌面服务器）" 
                             Foreground="#E6EDF3" FontSize="13" GroupName="SyncMode"/>
            </StackPanel>
        </Border>

        <Border Background="#21262D" CornerRadius="8" Padding="16" Grid.Row="1" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="ConnectionLabel" Text="服务器地址" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtServerAddress" 
                             Text="http://0.0.0.0:5800" Width="340" Height="32"
                             Foreground="#E6EDF3" Background="#161B22" BorderBrush="#30363D"
                             FontSize="13" Padding="8,4" VerticalContentAlignment="Center"
                             IsEnabled="False"/>
                    <Button x:Name="BtnStartStop" Content="启动服务" Width="80" Height="32" Margin="8,0,0,0"
                            Click="BtnStartStop_Click"
                            Background="#238636" Foreground="White" BorderBrush="#238636" BorderThickness="1"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Background="#161B22" CornerRadius="8" Padding="12" Grid.Row="2" Margin="0,12,0,0" MinHeight="80">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="同步日志" Style="{StaticResource SectionHeader}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList" Background="Transparent" BorderThickness="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#8B949E" FontSize="11" Margin="0,1,0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="BtnClose" Content="关闭" Width="90" Height="32"
                    Click="BtnClose_Click"
                    Background="Transparent" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
