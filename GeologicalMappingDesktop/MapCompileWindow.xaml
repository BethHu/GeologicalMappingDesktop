<Window x:Class="GeologicalMappingDesktop.MapCompileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        Title="图件编绘管理器" Height="850" Width="1400"
        FontFamily="SimSun, SimHei, Times New Roman"
        Background="#0D1117" WindowState="Maximized">
    <Window.Resources>
        <!-- 子菜单项（下拉面板内） -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>

        <!-- 顶级菜单项（悬浮胶囊） -->
        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HoverPill" Background="#30363D" CornerRadius="10" Opacity="0"/>
                            <ContentPresenter ContentSource="Header" Margin="12,6"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" Padding="4" MinWidth="180">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                        KeyboardNavigation.TabNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HoverPill" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HoverPill" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#3FB950"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="HoverPill" Background="#30363D" CornerRadius="12" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PillShadow" BlurRadius="14" ShadowDepth="0" Color="#3FB950" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="Transparent" BorderThickness="1" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverPill" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HoverPill" Property="Background" Value="#1B2B20"/>
                                <Setter TargetName="HoverPill" Property="BorderBrush" Value="#3FB950"/>
                                <Setter TargetName="HoverPill" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="HoverPill" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#3FB950"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillShadow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverPill" Background="#30363D" CornerRadius="12" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PillShadow" BlurRadius="14" ShadowDepth="0" Color="#3FB950" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="Transparent" Padding="8,2" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverPill" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverPill" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="PropBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="#3FB950"/>
        </Style>

        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="12" ShadowDepth="4" Color="#000000" Opacity="0.3"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 悬浮工具栏 ========== -->
        <Border Grid.Row="0" Background="Transparent" Padding="8,6" Margin="0,0,0,4">
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="14" Padding="6,2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 菜单 -->
                    <Menu Grid.Column="0" VerticalAlignment="Center" Margin="2,0">
                        <MenuItem Header="文件(F)" Style="{StaticResource TopMenuItem}">
                            <MenuItem Header="新建布局" Click="MenuItem_NewLayout_Click"/>
                            <MenuItem Header="打开布局..." Click="MenuItem_OpenLayout_Click"/>
                            <Separator/>
                            <MenuItem Header="保存布局" Click="MenuItem_SaveLayout_Click"/>
                            <MenuItem Header="另存为..." Click="MenuItem_SaveAsLayout_Click"/>
                            <Separator/>
                            <MenuItem Header="退出" Click="MenuItem_Exit_Click"/>
                        </MenuItem>
                        <MenuItem Header="添加(A)" Style="{StaticResource TopMenuItem}">
                            <MenuItem Header="地图框架" Click="BtnAddMap_Click"/>
                            <MenuItem Header="图例" Click="BtnAddLegend_Click"/>
                            <MenuItem Header="比例尺" Click="BtnAddScaleBar_Click"/>
                            <MenuItem Header="指北针" Click="BtnAddNorthArrow_Click"/>
                            <MenuItem Header="文字标签" Click="BtnAddText_Click"/>
                            <MenuItem Header="图片" Click="BtnAddImage_Click"/>
                            <Separator/>
                            <MenuItem Header="矩形" Click="BtnAddRectangle_Click"/>
                            <MenuItem Header="线条" Click="BtnAddLine_Click"/>
                        </MenuItem>
                        <MenuItem Header="输出(O)" Style="{StaticResource TopMenuItem}">
                            <MenuItem Header="导出图片..." Click="MenuItem_ExportImage_Click"/>
                            <MenuItem Header="导出PDF..." Click="MenuItem_ExportPdf_Click"/>
                            <Separator/>
                            <MenuItem Header="打印..." Click="MenuItem_Print_Click"/>
                        </MenuItem>
                        <MenuItem Header="帮助(H)" Style="{StaticResource TopMenuItem}">
                            <MenuItem Header="使用说明" Click="MenuItem_Help_Click"/>
                            <MenuItem Header="关于" Click="MenuItem_About_Click"/>
                        </MenuItem>
                    </Menu>

                    <Border Grid.Column="1" Width="1" Background="#30363D" Height="22" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- 工具栏按钮 -->
                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FontFamily="Segoe UI Symbol">
                        <WrapPanel VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource ToolBtn}" x:Name="BtnSelectTool" IsChecked="True" ToolTip="选择工具 (S)" Click="BtnSelectTool_Click">🖱</RadioButton>
                            <Separator Width="1" Background="#30363D" Margin="4,8"/>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddMap" ToolTip="添加地图框架" Click="BtnAddMap_Click">🗺</Button>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddLegend" ToolTip="添加图例" Click="BtnAddLegend_Click">📊</Button>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddScaleBar" ToolTip="添加比例尺" Click="BtnAddScaleBar_Click">📏</Button>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddNorthArrow" ToolTip="添加指北针" Click="BtnAddNorthArrow_Click">⬆</Button>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddText" ToolTip="添加文字" Click="BtnAddText_Click">📝</Button>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddImage" ToolTip="添加图片" Click="BtnAddImage_Click">🖼</Button>
                            <Separator Width="1" Background="#30363D" Margin="4,8"/>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddRectangle" ToolTip="矩形" Click="BtnAddRectangle_Click">🔲</Button>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnAddLine" ToolTip="线条" Click="BtnAddLine_Click">〰</Button>
                            <Separator Width="1" Background="#30363D" Margin="4,8"/>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnDelete" ToolTip="删除选中项" Click="BtnDelete_Click" Foreground="#FF7B72">❌</Button>
                            <Button Style="{StaticResource ActBtn}" x:Name="BtnClearAll" ToolTip="清空布局" Click="BtnClearAll_Click">🗑</Button>
                            <Separator Width="1" Background="#30363D" Margin="4,8"/>
                            <CheckBox x:Name="ChkSnapToGrid" Content="吸附" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Margin="4,0" IsChecked="True"/>
                            <TextBlock Text="缩放:" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <Slider x:Name="SliderZoom" Width="120" Minimum="0.1" Maximum="4.0" Value="1.0" SmallChange="0.1" LargeChange="0.25" TickFrequency="0.25" TickPlacement="BottomRight" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtZoom" Text="100%" Foreground="#E6EDF3" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" Width="50"/>
                            <TextBlock Text="|" Foreground="#30363D" FontSize="14" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- Layout Canvas Area -->
            <Border Grid.Column="0" Background="#0D1117" Margin="4">
                <Grid>
                    <ScrollViewer x:Name="LayoutScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#0D1117" PanningMode="Both">
                        <Border x:Name="PaperBorder" Background="White" CornerRadius="2"
                                BorderBrush="#30363D" BorderThickness="1"
                                Effect="{DynamicResource DropShadowEffect}">
                            <Canvas x:Name="LayoutCanvas" Background="White"
                                    MouseDown="LayoutCanvas_MouseDown"
                                    MouseMove="LayoutCanvas_MouseMove"
                                    MouseUp="LayoutCanvas_MouseUp"
                                    PreviewMouseWheel="LayoutCanvas_PreviewMouseWheel"
                                    ClipToBounds="True"/>
                        </Border>
                    </ScrollViewer>

                    <!-- Hint when empty -->
                    <TextBlock x:Name="TxtHint" Text="点击工具栏按钮添加布局元素&#x0a;或从「添加」菜单中选择" Foreground="#30363D" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               IsHitTestVisible="False" Visibility="Visible"/>

                    <!-- MapView overlay for live map frame (currently unused) -->
                    <Border x:Name="MapOverlayBorder" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Properties Panel -->
            <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1,0,0,0" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="属性面板" FontSize="14" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,10"/>

                        <!-- Page properties panel (shown when nothing selected) -->
                        <StackPanel x:Name="PagePropPanel">
                            <TextBlock Text="页面设置" FontSize="13" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="纸张大小"/>
                            <ComboBox x:Name="CboPageSize" SelectedIndex="3" Height="30" Margin="0,2,0,6"
                                      Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="12">
                                <ComboBoxItem Content="A0"/>
                                <ComboBoxItem Content="A1"/>
                                <ComboBoxItem Content="A2"/>
                                <ComboBoxItem Content="A3"/>
                                <ComboBoxItem Content="A4"/>
                                <ComboBoxItem Content="自定义"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource PropLabel}" Text="方向"/>
                            <ComboBox x:Name="CboOrientation" SelectedIndex="1" Height="30" Margin="0,2,0,6"
                                      Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="12">
                                <ComboBoxItem Content="纵向"/>
                                <ComboBoxItem Content="横向"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource PropLabel}" Text="宽度 (mm)"/>
                            <TextBox x:Name="TxtPageW" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtPageDim_LostFocus"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="高度 (mm)"/>
                            <TextBox x:Name="TxtPageH" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtPageDim_LostFocus"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="导出 DPI"/>
                            <TextBox x:Name="TxtDpi" Text="300" Style="{StaticResource PropBox}" Margin="0,2,0,4"/>
                            <Separator Background="#30363D" Margin="0,8,0,8"/>
                            <Button Style="{StaticResource ActBtn}" Content="🗺️ 刷新截图" Click="BtnRefreshMap_Click" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource ActBtn}" Content="📋 更新图例" Click="BtnUpdateLegend_Click" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource ActBtn}" Content="🔄 刷新所有" Click="BtnRefreshAll_Click"/>
                        </StackPanel>

                        <!-- Selected item properties -->
                        <StackPanel x:Name="ItemPropPanel" Visibility="Collapsed">
                            <TextBlock x:Name="TxtItemType" Text="选中: 无" FontSize="13" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="名称"/>
                            <TextBox x:Name="TxtItemName" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="X (mm)"/>
                            <TextBox x:Name="TxtItemX" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="Y (mm)"/>
                            <TextBox x:Name="TxtItemY" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="宽度 (mm)"/>
                            <TextBox x:Name="TxtItemW" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="高度 (mm)"/>
                            <TextBox x:Name="TxtItemH" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus"/>
                            <TextBlock Style="{StaticResource PropLabel}" Text="旋转 (°)"/>
                            <TextBox x:Name="TxtItemRot" Text="0" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus"/>

                            <!-- Text-specific properties -->
                            <StackPanel x:Name="TextPropPanel" Visibility="Collapsed">
                                <Separator Background="#30363D" Margin="0,8,0,8"/>
                                <TextBlock Style="{StaticResource PropLabel}" Text="文字内容"/>
                                <TextBox x:Name="TxtItemContent" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="字体" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CboTextFontName" Width="120" Height="22" SelectedIndex="0"
                                              Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                              SelectionChanged="CboTextFontName_SelectionChanged">
                                        <ComboBoxItem Content="Times New Roman"/>
                                        <ComboBoxItem Content="Arial"/>
                                        <ComboBoxItem Content="Microsoft YaHei"/>
                                        <ComboBoxItem Content="SimSun"/>
                                        <ComboBoxItem Content="SimHei"/>
                                        <ComboBoxItem Content="KaiTi"/>
                                        <ComboBoxItem Content="FangSong"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="字号" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtItemFontSize" Text="14" Width="50" Height="24"
                                             Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3" FontSize="11"
                                             LostFocus="TxtItemProp_LostFocus"/>
                                    <CheckBox x:Name="ChkTextBold" Content="B" FontWeight="Bold" Foreground="#E6EDF3" Margin="6,0,2,0"
                                              Checked="ChkTextStyle_Changed" Unchecked="ChkTextStyle_Changed"/>
                                    <CheckBox x:Name="ChkTextItalic" Content="I" FontStyle="Italic" Foreground="#E6EDF3"
                                              Checked="ChkTextStyle_Changed" Unchecked="ChkTextStyle_Changed"/>
                                    <Border x:Name="ClrTextPreview" Width="18" Height="18" Background="Black"
                                            BorderBrush="#30363D" BorderThickness="1" Margin="6,0,0,0"/>
                                    <Button Content="颜色" Padding="4,1" FontSize="10" Click="BtnTextColor_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="22" Margin="2,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Scale bar specific properties -->
                            <StackPanel x:Name="ScalePropPanel" Visibility="Collapsed">
                                <Separator Background="#30363D" Margin="0,8,0,8"/>
                                <TextBlock Style="{StaticResource PropLabel}" Text="地图比例尺分母 (1:)"/>
                                <TextBox x:Name="TxtScaleBarScale" Text="50000" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtItemProp_LostFocus"/>
                            </StackPanel>

                            <!-- MapFrame specific properties -->
                            <StackPanel x:Name="MapFramePropPanel" Visibility="Collapsed">
                                <Separator Background="#30363D" Margin="0,8,0,8"/>
                                <TextBlock Style="{StaticResource PropLabel}" Text="地图比例尺分母 (1:)"/>
                                <TextBox x:Name="TxtMapScale" Text="50000" Style="{StaticResource PropBox}" Margin="0,2,0,4" LostFocus="TxtMapFrameProp_LostFocus"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Button Style="{StaticResource ActBtn}" Content="🔍+" Width="50" Click="BtnMapZoomIn_Click" ToolTip="放大 2 倍"/>
                                    <Button Style="{StaticResource ActBtn}" Content="🔍−" Width="50" Margin="4,0,0,0" Click="BtnMapZoomOut_Click" ToolTip="缩小 2 倍"/>
                                    <Button Style="{StaticResource ActBtn}" Content="↻" Width="50" Margin="4,0,0,0" Click="BtnMapRefresh_Click" ToolTip="刷新地图"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource PropLabel}" Text="范围 XMin"/>
                                <TextBox x:Name="TxtMapExtentXMin" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,2" LostFocus="TxtMapFrameProp_LostFocus"/>
                                <TextBlock Style="{StaticResource PropLabel}" Text="范围 YMin"/>
                                <TextBox x:Name="TxtMapExtentYMin" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,2" LostFocus="TxtMapFrameProp_LostFocus"/>
                                <TextBlock Style="{StaticResource PropLabel}" Text="范围 XMax"/>
                                <TextBox x:Name="TxtMapExtentXMax" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,2" LostFocus="TxtMapFrameProp_LostFocus"/>
                                <TextBlock Style="{StaticResource PropLabel}" Text="范围 YMax"/>
                                <TextBox x:Name="TxtMapExtentYMax" Text="" Style="{StaticResource PropBox}" Margin="0,2,0,2" LostFocus="TxtMapFrameProp_LostFocus"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Button Style="{StaticResource ActBtn}" Content="平移 ↑" Width="60" Click="BtnMapPanUp_Click"/>
                                    <Button Style="{StaticResource ActBtn}" Content="平移 ↓" Width="60" Margin="4,0,0,0" Click="BtnMapPanDown_Click"/>
                                    <Button Style="{StaticResource ActBtn}" Content="平移 ←" Width="60" Margin="4,0,0,0" Click="BtnMapPanLeft_Click"/>
                                    <Button Style="{StaticResource ActBtn}" Content="平移 →" Width="60" Margin="4,0,0,0" Click="BtnMapPanRight_Click"/>
                                </StackPanel>

                                <!-- ========== 图框边框 ========== -->
                                <Separator Background="#30363D" Margin="0,4,0,6"/>
                                <TextBlock Text="图框边框" FontSize="13" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="颜色" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                    <Border x:Name="ClrMapFrameBorder" Width="18" Height="18" Background="#808080"
                                            BorderBrush="#30363D" BorderThickness="1"/>
                                    <Button Content="选择" Padding="6,1" FontSize="11" Click="BtnMapFrameBorderColor_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="22" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="线宽" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtMapFrameBorderWidth" Text="1" Width="50" Height="22"
                                             Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3" FontSize="11"
                                             LostFocus="TxtMapFrameProp_LostFocus"/>
                                </StackPanel>

                                <!-- ========== 经纬网 (Grid/Graticule) Settings ========== -->
                                <Separator Background="#30363D" Margin="0,4,0,6"/>
                                <TextBlock Text="经纬网" FontSize="13" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkGridEnabled" Content="启用经纬网" Foreground="#E6EDF3" Margin="0,0,0,4"
                                          Checked="GridSettingChanged" Unchecked="GridSettingChanged"/>
                                <StackPanel x:Name="GridSettingsPanel" Margin="0,0,0,4">
                                    <!-- 间距模式 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="间距" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CboGridSpacing" SelectedIndex="0" Width="70" Height="22"
                                                  Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                                  SelectionChanged="GridSettingChanged">
                                            <ComboBoxItem Content="自动"/>
                                            <ComboBoxItem Content="固定"/>
                                        </ComboBox>
                                        <StackPanel x:Name="GridFixedPanel" Orientation="Horizontal" IsEnabled="False" Margin="4,0,0,0">
                                            <TextBox x:Name="TxtGridInterval" Text="1.0" Width="46" Height="22"
                                                     Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3" FontSize="11"
                                                     LostFocus="GridSettingChanged"/>
                                            <TextBlock Text="°" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 显示模式 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="显示" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CboGridDisplayMode" SelectedIndex="0" Width="130" Height="22"
                                                  Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                                  SelectionChanged="GridSettingChanged">
                                            <ComboBoxItem Content="仅网格线"/>
                                            <ComboBoxItem Content="仅标注"/>
                                            <ComboBoxItem Content="网格线+标注"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 网格线颜色+线宽 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="网格线" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                        <Border x:Name="ClrGridLinePreview" Width="18" Height="18" Background="#646464"
                                                BorderBrush="#30363D" BorderThickness="1" VerticalAlignment="Center"/>
                                        <Button Content="颜色" Padding="6,1" FontSize="11" Click="BtnGridLineColor_Click"
                                                Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="22" Margin="4,0,4,0"/>
                                        <TextBox x:Name="TxtGridLineWidth" Text="0.5" Width="36" Height="22"
                                                 Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3" FontSize="11"
                                                 LostFocus="GridSettingChanged"/>
                                        <TextBlock Text="宽" Foreground="#8B949E" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>

                                    <!-- 字体 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="字体" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CboGridFontName" Width="120" Height="22" SelectedIndex="0"
                                                  Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                                  SelectionChanged="GridSettingChanged">
                                            <ComboBoxItem Content="Times New Roman"/>
                                            <ComboBoxItem Content="Arial"/>
                                            <ComboBoxItem Content="Microsoft YaHei"/>
                                            <ComboBoxItem Content="SimSun"/>
                                            <ComboBoxItem Content="SimHei"/>
                                            <ComboBoxItem Content="KaiTi"/>
                                            <ComboBoxItem Content="FangSong"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 标注颜色+字号+粗斜体 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="标注" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                        <Border x:Name="ClrGridFontPreview" Width="18" Height="18" Background="#3C3C3C"
                                                BorderBrush="#30363D" BorderThickness="1" VerticalAlignment="Center"/>
                                        <Button Content="颜色" Padding="6,1" FontSize="11" Click="BtnGridFontColor_Click"
                                                Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="22" Margin="4,0,4,0"/>
                                        <TextBox x:Name="TxtGridFontSize" Text="10" Width="30" Height="22"
                                                 Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3" FontSize="11"
                                                 LostFocus="GridSettingChanged"/>
                                        <TextBlock Text="号" Foreground="#8B949E" FontSize="10" VerticalAlignment="Center" Margin="1,0,4,0"/>
                                        <CheckBox x:Name="ChkGridFontBold" Content="B" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,2,0"
                                                  Checked="GridSettingChanged" Unchecked="GridSettingChanged"/>
                                        <CheckBox x:Name="ChkGridFontItalic" Content="I" FontStyle="Italic" Foreground="#E6EDF3"
                                                  Checked="GridSettingChanged" Unchecked="GridSettingChanged"/>
                                    </StackPanel>

                                    <!-- 标注边控制 -->
                                    <StackPanel Margin="0,2,0,0">
                                        <TextBlock Text="标注边" Style="{StaticResource PropLabel}" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ChkGridTop" Content="上边" Foreground="#E6EDF3" Width="48"
                                                      Checked="GridSettingChanged" Unchecked="GridSettingChanged"/>
                                            <ComboBox x:Name="CboGridTopDir" SelectedIndex="0" Width="58" Height="22"
                                                      Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                                      SelectionChanged="GridSettingChanged">
                                                <ComboBoxItem Content="水平"/><ComboBoxItem Content="垂直"/>
                                            </ComboBox>
                                            <CheckBox x:Name="ChkGridBottom" Content="下边" Foreground="#E6EDF3" Width="48" Margin="4,0,0,0"
                                                      Checked="GridSettingChanged" Unchecked="GridSettingChanged"/>
                                            <ComboBox x:Name="CboGridBottomDir" SelectedIndex="0" Width="58" Height="22"
                                                      Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                                      SelectionChanged="GridSettingChanged">
                                                <ComboBoxItem Content="水平"/><ComboBoxItem Content="垂直"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <CheckBox x:Name="ChkGridLeft" Content="左边" Foreground="#E6EDF3" Width="48"
                                                      Checked="GridSettingChanged" Unchecked="GridSettingChanged"/>
                                            <ComboBox x:Name="CboGridLeftDir" SelectedIndex="1" Width="58" Height="22"
                                                      Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                                      SelectionChanged="GridSettingChanged">
                                                <ComboBoxItem Content="水平"/><ComboBoxItem Content="垂直"/>
                                            </ComboBox>
                                            <CheckBox x:Name="ChkGridRight" Content="右边" Foreground="#E6EDF3" Width="48" Margin="4,0,0,0"
                                                      Checked="GridSettingChanged" Unchecked="GridSettingChanged"/>
                                            <ComboBox x:Name="CboGridRightDir" SelectedIndex="1" Width="58" Height="22"
                                                      Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" FontSize="11"
                                                      SelectionChanged="GridSettingChanged">
                                                <ComboBoxItem Content="水平"/><ComboBoxItem Content="垂直"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- ========== Rectangle Fill & Stroke ========== -->
                            <StackPanel x:Name="RectPropPanel" Visibility="Collapsed">
                                <Separator Background="#30363D" Margin="0,8,0,8"/>
                                <TextBlock Text="矩形样式" FontSize="13" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="填充" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                    <Border x:Name="ClrRectFill" Width="18" Height="18" Background="#E0E0E0"
                                            BorderBrush="#30363D" BorderThickness="1"/>
                                    <Button Content="颜色" Padding="6,1" FontSize="11" Click="BtnRectFillColor_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="22" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="边框" Style="{StaticResource PropLabel}" Width="44" VerticalAlignment="Center"/>
                                    <Border x:Name="ClrRectStroke" Width="18" Height="18" Background="#333333"
                                            BorderBrush="#30363D" BorderThickness="1"/>
                                    <Button Content="颜色" Padding="6,1" FontSize="11" Click="BtnRectStrokeColor_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="22" Margin="4,0,0,4"/>
                                    <TextBox x:Name="TxtRectStrokeWidth" Text="1" Width="36" Height="22"
                                             Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3" FontSize="11"
                                             LostFocus="TxtRectProp_LostFocus"/>
                                    <TextBlock Text="粗" Foreground="#8B949E" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ========== Legend Layer List ========== -->
                            <StackPanel x:Name="LegendPropPanel" Visibility="Collapsed">
                                <Separator Background="#30363D" Margin="0,8,0,8"/>
                                <TextBlock Text="图例图层排序" FontSize="13" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,4"/>
                                <ListBox x:Name="LegendLayerList" Height="160" Background="#0D1117" BorderBrush="#30363D"
                                         Foreground="#E6EDF3" FontSize="11" DisplayMemberPath="DisplayName" SelectionMode="Single"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="↑ 上移" Padding="6,2" FontSize="11" Click="BtnLegendMoveUp_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="24"/>
                                    <Button Content="↓ 下移" Padding="6,2" FontSize="11" Click="BtnLegendMoveDown_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="24" Margin="6,0,6,0"/>
                                    <Button Content="刷新图例" Padding="6,2" FontSize="11" Click="BtnLegendRefresh_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3" Height="24"/>
                                    <Button Content="🗑 删除" Padding="6,2" FontSize="11" Click="BtnLegendDelete_Click"
                                            Background="#21262D" BorderBrush="#30363D" Foreground="#FF7B72" Height="24" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator Background="#30363D" Margin="0,8,0,8"/>
                            <Button Style="{StaticResource ActBtn}" Content="🗑️ 删除此项" Click="BtnDeleteItem_Click" Foreground="#FF7B72"/>
                            <Button Style="{StaticResource ActBtn}" Content="⬆ 置于顶层" Click="BtnBringToFront_Click" Margin="0,4,0,0"/>
                            <Button Style="{StaticResource ActBtn}" Content="⬇ 置于底层" Click="BtnSendToBack_Click" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="8,2">
            <TextBlock x:Name="TxtStatusBar" Text="就绪 | 选中工具: 选择" Foreground="#8B949E" FontSize="11"/>
        </Border>
    </Grid>
</Window>
