<Window x:Class="GeologicalMappingDesktop.LayerPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图层属性" Height="700" Width="660"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#C9D1D9"
        ResizeMode="CanResizeWithGrip"
        MinWidth="520" MinHeight="520">
    <Window.Resources>
        <Style x:Key="DarkTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#30363D" BorderThickness="1,1,1,0"
                                Margin="0,0,2,0" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid Background="Transparent">
                <Path x:Name="Arrow" Data="M0,0 L5,5 L10,0"
                      Stroke="#8B949E" StrokeThickness="1.5"
                      Fill="Transparent" HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E6EDF3"/>
                        <Setter Property="Background" Value="#21262D"/>
                        <Setter Property="BorderBrush" Value="#30363D"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Margin="0,0,4,0"/>
                                    <ToggleButton x:Name="DropDownToggle" Grid.Column="1"
                                                  Template="{StaticResource ComboBoxToggleButton}"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Width="16" Height="16" Margin="0,0,2,0"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="3">
                                        <ScrollViewer>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0" FontSize="15" FontWeight="Bold"
                   Foreground="#58A6FF" Margin="0,0,0,10" Text="图层属性"/>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- 源 -->
            <TabItem Header="源" Style="{StaticResource DarkTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <TextBlock Text="图层名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtLayerName" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="图层类型" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtLayerType" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="数据源路径" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSourcePath" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="存储位置 / 表名" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtStorage" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="坐标系" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSpatialRef" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="WKID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtWkid" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="几何类型" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtGeomType" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="要素数量" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtFeatureCount" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="空间范围（四至）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtExtent" Style="{StaticResource FieldValue}" MinHeight="60"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 符号系统 -->
            <TabItem Header="符号系统" Style="{StaticResource DarkTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <TextBlock Text="渲染方式" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboRendererType" Height="28" Margin="0,0,0,10"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="CboRendererType_SelectionChanged"/>

                        <TextBlock x:Name="TxtGeomHint" Text="几何类型: —" Foreground="#58A6FF" FontSize="12" Margin="0,0,0,10"/>

                        <!-- 点符号 -->
                        <StackPanel x:Name="PanelPointSym" Visibility="Collapsed">
                            <TextBlock Text="点符号编辑" Style="{StaticResource FieldLabel}"/>
                            <Border x:Name="BrdPointSymbolPreview" Width="64" Height="64"
                                    Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8"/>
                            <Button x:Name="BtnEditPointSymbol" Content="打开符号编辑器" Height="28" Margin="0,0,0,6"
                                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                                    Click="BtnEditPointSymbol_Click"/>
                        </StackPanel>

                        <!-- 线符号 -->
                        <StackPanel x:Name="PanelLineSym" Visibility="Collapsed">
                            <TextBlock Text="线符号编辑" Style="{StaticResource FieldLabel}"/>
                            <Border x:Name="BrdLineSymbolPreview" Width="120" Height="40"
                                    Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8"/>
                            <Button x:Name="BtnEditLineSymbol" Content="打开线符号编辑器" Height="28" Margin="0,0,0,6"
                                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                                    Click="BtnEditLineSymbol_Click"/>
                        </StackPanel>

                        <!-- 面符号（与点/线相同：仅预览 + 打开编辑器按钮，所有编辑在 SymbolEditorDialog 中完成） -->
                        <StackPanel x:Name="PanelFillSym" Visibility="Collapsed">
                            <TextBlock Text="面符号编辑" Style="{StaticResource FieldLabel}"/>
                            <Border x:Name="BrdFillSymbolPreview" Width="120" Height="50"
                                    Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8"/>
                            <Button x:Name="BtnEditFillSymbol" Content="打开面符号编辑器" Height="28" Margin="0,0,0,6"
                                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                                    Click="BtnEditFillSymbol_Click"/>
                        </StackPanel>

                        <!-- 唯一值分类面板（独立于填充面板，适用于所有几何类型） -->
                        <StackPanel x:Name="PanelClassified" Visibility="Collapsed">
                            <TextBlock Text="分类字段" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CboClassField" Height="28" Margin="0,0,0,10"
                                      Style="{StaticResource DarkComboBox}"
                                      SelectionChanged="CboClassField_SelectionChanged"/>
                            <TextBlock Text="色阶预设" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CboColorRamp" Height="28" Margin="0,0,0,6"
                                      Style="{StaticResource DarkComboBox}"
                                      SelectionChanged="CboColorRamp_SelectionChanged">
                                <ComboBoxItem Content="红-黄-绿" Tag="RYG"/>
                                <ComboBoxItem Content="蓝-紫-红" Tag="BPR"/>
                                <ComboBoxItem Content="单色渐变（蓝）" Tag="MonoBlue"/>
                                <ComboBoxItem Content="单色渐变（绿）" Tag="MonoGreen"/>
                                <ComboBoxItem Content="彩虹" Tag="Rainbow"/>
                            </ComboBox>

                            <!-- 色带预览 -->
                            <Border x:Name="BrdColorRampPreview" Height="20" CornerRadius="3"
                                    BorderBrush="#30363D" BorderThickness="1" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="分类列表" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           Grid.Column="0"/>
                                <Button Content="+ 添加" Height="24" Grid.Column="1" Padding="10,0" Margin="0,0,4,0"
                                        Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043"
                                        Click="BtnAddClass_Click"/>
                                <Button Content="删除" Height="24" Grid.Column="2" Padding="10,0"
                                        Background="#3D1F1F" Foreground="#FF7B72" BorderBrush="#30363D"
                                        Click="BtnRemoveClass_Click"/>
                            </Grid>

                            <DataGrid x:Name="ClassGrid" Height="160" Margin="0,0,0,6"
                                      AutoGenerateColumns="False" HeadersVisibility="Column"
                                      Background="#0D2137" Foreground="#E6EDF3"
                                      BorderBrush="#1F6FEB" BorderThickness="1"
                                      RowBackground="#0D2137" AlternatingRowBackground="#0F263E"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CellEditEnding="ClassGrid_CellEditEnding"
                                      LoadingRow="ClassGrid_LoadingRow">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#161B22"/>
                                        <Setter Property="Foreground" Value="#8B949E"/>
                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Height" Value="26"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="#E6EDF3"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="26"/>
                                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Background}"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="样式" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="48" Height="20"
                                                        CornerRadius="2" BorderBrush="#30363D" BorderThickness="1"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="CellColorBorder_MouseLeftButtonUp">
                                                    <Image Source="{Binding PreviewImage}" Width="46" Height="18"
                                                           Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="类别名" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                    <DataGridTextColumn Header="标注名" Binding="{Binding Label, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 自动匹配按钮（分类渲染模式下可见，按几何类型显示对应按钮） -->
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="自动符号匹配" Foreground="#8B949E" FontSize="11" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="BtnLithoAutoFill" Content="岩性花纹自动填充" Height="28"
                                                Margin="0,0,6,0" Padding="12,0"
                                                Background="#1F6FEB" Foreground="White" BorderBrush="#30363D"
                                                Visibility="Collapsed"
                                                Click="BtnLithoAutoFill_Click"/>
                                        <Button x:Name="BtnLineAutoMatch" Content="断层/界线自动匹配" Height="28"
                                                Margin="0,0,6,0" Padding="12,0"
                                                Background="#1F6FEB" Foreground="White" BorderBrush="#30363D"
                                                Visibility="Collapsed"
                                                Click="BtnLineAutoMatch_Click"/>
                                        <Button x:Name="BtnPointAutoMatch" Content="矿产符号自动匹配" Height="28"
                                                Margin="0,0,6,0" Padding="12,0"
                                                Background="#1F6FEB" Foreground="White" BorderBrush="#30363D"
                                                Visibility="Collapsed"
                                                Click="BtnPointAutoMatch_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="TxtSymbologyNote" Foreground="#8B949E" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="面填充支持实心、Runtime 影线、岩性花纹多符号层。唯一值渲染时点「添加分类」可从数据中获取字段值。"/>

                        <Border x:Name="PanelSymbolPreview" Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="4" MinHeight="140" Margin="0,0,0,4">
                            <Grid>
                                <TextBlock Text="符号预览" Foreground="#484F58" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" FontSize="11"/>
                                <Canvas x:Name="SymbolPreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Width="240" Height="110"/>
                                <Image x:Name="ImgPatternPreview" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Width="200" Height="90" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 显示 -->
            <TabItem Header="显示" Style="{StaticResource DarkTab}">
                <StackPanel Margin="8">
                    <TextBlock Text="透明度" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldOpacity" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="5" IsSnapToTickEnabled="False"
                                VerticalAlignment="Center" ValueChanged="SldOpacity_ValueChanged"/>
                        <TextBlock x:Name="TxtOpacityVal" Grid.Column="1" Text="100%"
                                   Foreground="#E6EDF3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="0% = 完全透明，100% = 不透明" Foreground="#484F58" FontSize="11" Margin="0,0,0,16"/>

                    <TextBlock Text="最大显示比例（更近）" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtMaxScale" Background="#161B22" Foreground="#E6EDF3"
                             BorderBrush="#30363D" Padding="6,4" Margin="0,0,0,4"/>
                    <TextBlock Text="例如 1000 表示比例尺大于 1:1000 时隐藏；0 = 不限制" Foreground="#484F58" FontSize="11" Margin="0,0,0,12"/>

                    <TextBlock Text="最小显示比例（更远）" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtMinScale" Background="#161B22" Foreground="#E6EDF3"
                             BorderBrush="#30363D" Padding="6,4" Margin="0,0,0,4"/>
                    <TextBlock Text="例如 500000 表示比例尺小于 1:500000 时隐藏；0 = 不限制" Foreground="#484F58" FontSize="11" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkVisible" Content="图层可见"
                              Foreground="#E6EDF3" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 标注 -->
            <TabItem Header="标注" Style="{StaticResource DarkTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <CheckBox x:Name="ChkLabelVisible" Content="启用标注"
                                  Foreground="#E6EDF3" FontSize="13" Margin="0,0,0,10"
                                  Checked="LabelSetting_Changed" Unchecked="LabelSetting_Changed"/>

                        <TextBlock Text="标注字段" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboLabelField" Height="28" Margin="0,0,0,10"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="LabelSetting_Changed"/>

                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboFontFamily" Height="28" Margin="0,0,0,10"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="LabelSetting_Changed"/>

                        <TextBlock Text="标注位置" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboLabelPosition" Height="28" Margin="0,0,0,10"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="LabelSetting_Changed">
                            <ComboBoxItem Content="中心" Tag="Center"/>
                            <ComboBoxItem Content="上" Tag="Top"/>
                            <ComboBoxItem Content="下" Tag="Bottom"/>
                            <ComboBoxItem Content="左" Tag="Left"/>
                            <ComboBoxItem Content="右" Tag="Right"/>
                            <ComboBoxItem Content="左上" Tag="TopLeft"/>
                            <ComboBoxItem Content="右上" Tag="TopRight"/>
                            <ComboBoxItem Content="左下" Tag="BottomLeft"/>
                            <ComboBoxItem Content="右下" Tag="BottomRight"/>
                        </ComboBox>

                        <TextBlock Text="字体大小" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SldLabelFontSize" Minimum="6" Maximum="72" Value="12"
                                    ValueChanged="LabelSetting_Changed"/>
                            <TextBlock x:Name="TxtLabelFontSize" Grid.Column="1" Text="12" Foreground="#E6EDF3"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="字体颜色" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border x:Name="BrdLabelColor" Width="36" Height="28" Background="#FF0000"
                                    BorderBrush="#30363D" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0"/>
                            <Button Content="选择颜色..." Height="28" Padding="10,0"
                                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                                    Click="BtnLabelColor_Click"/>
                        </StackPanel>

                        <TextBlock Text="偏移量 X（像素）" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SldLabelOffsetX" Minimum="-50" Maximum="50" Value="0"
                                    ValueChanged="LabelSetting_Changed"/>
                            <TextBlock x:Name="TxtLabelOffsetX" Grid.Column="1" Text="0" Foreground="#E6EDF3"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="偏移量 Y（像素）" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SldLabelOffsetY" Minimum="-50" Maximum="50" Value="0"
                                    ValueChanged="LabelSetting_Changed"/>
                            <TextBlock x:Name="TxtLabelOffsetY" Grid.Column="1" Text="0" Foreground="#E6EDF3"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <CheckBox x:Name="ChkLabelConflict" Content="冲突检测（避免标注重叠）"
                                  Foreground="#E6EDF3" Margin="0,0,0,6"
                                  Checked="LabelSetting_Changed" Unchecked="LabelSetting_Changed"/>

                        <Border Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="4" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="标注预览" Foreground="#484F58" FontSize="11" HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <Canvas x:Name="LabelPreviewCanvas" Width="500" Height="100" Background="Transparent"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="应用" Width="80" Height="30" Margin="0,0,8,0"
                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                    Click="BtnApply_Click"/>
            <Button Content="确定" Width="80" Height="30" Margin="0,0,8,0"
                    Background="#238636" Foreground="White" BorderBrush="#2EA043"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="30"
                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
