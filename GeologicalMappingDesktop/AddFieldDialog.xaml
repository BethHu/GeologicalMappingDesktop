<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GeologicalMappingDesktop.AddFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加字段" Height="569.25" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E7681"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ToggleButton x:Name="toggleButton" 
                                                  Grid.Column="2" 
                                                  Focusable="false"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" Padding="8">
                                                    <Path x:Name="Arrow" 
                                                          Fill="#8B949E"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M0 0 L3 3 L6 0 Z"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="contentPresenter"
                                                      IsHitTestVisible="False" 
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#21262D"
                                        BorderBrush="#30363D"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="2"
                                        MaxHeight="250">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#238636"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#21262D" CornerRadius="8" Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="字段名称（仅 ASCII，≤10 字符 — Shapefile 兼容）" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtFieldName" 
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Background="#21262D" CornerRadius="8" Padding="16" Margin="0,0,0,16" Grid.Row="1">
            <StackPanel>
                <TextBlock Text="字段类型" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <ComboBox x:Name="CboFieldType" 
                          Style="{StaticResource ComboBoxStyle}"
                          Margin="0,0,0,0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}"/>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="文本" Tag="Text"/>
                    <ComboBoxItem Content="短整型" Tag="ShortInteger"/>
                    <ComboBoxItem Content="长整型" Tag="LongInteger"/>
                    <ComboBoxItem Content="浮点型" Tag="Float"/>
                    <ComboBoxItem Content="双精度" Tag="Double"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border x:Name="BorderFieldProperties" Background="#21262D" CornerRadius="8" Padding="16" Margin="0,0,0,16" Grid.Row="2">
            <StackPanel>
                <TextBlock Text="字段属性" Style="{StaticResource LabelStyle}" Margin="0,0,0,12"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="长度" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLength" 
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="255"
                                 Margin="0,0,8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="精度" Foreground="#8B949E" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPrecision" 
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="0"
                                 Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkNullable" 
                              Content="允许空值" 
                              Foreground="#E6EDF3" 
                              FontSize="13"
                              IsChecked="True"
                              Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Background="#0D1117" CornerRadius="8" Padding="16" Grid.Row="3">
            <StackPanel>
                <TextBlock Text="字段别名（显示用，可输入中文）" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtFieldAlias" 
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,4"/>
                <TextBlock Text="如字段名需用中文，请在别名中输入；字段名保持英文以兼容 Shapefile" 
                           Foreground="#6E7681" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="12" Margin="0,8,0,0">
            <Button x:Name="BtnCancel" Content="取消" Width="90" Height="32" Margin="0,0,10,0"
                    Click="BtnCancel_Click"
                    Background="Transparent" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="BtnOK" Content="添加" Width="90" Height="32"
                    Click="BtnOK_Click"
                    Background="#238636" Foreground="White" BorderBrush="#238636" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EA043"/>
                                <Setter Property="BorderBrush" Value="#2EA043"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#6E7681"/>
                                <Setter Property="BorderBrush" Value="#6E7681"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>