<Window x:Class="GeologicalMappingDesktop.BatchCorrectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量纠错" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        FontFamily="Microsoft YaHei"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="选择目标图层和要素" Foreground="#8B949E" FontSize="12" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图层:" Foreground="#E6EDF3" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboLayer" Grid.Column="1" Height="28"
                              Foreground="#E6EDF3" Background="#21262D" BorderBrush="#30363D"/>
                    <Button x:Name="BtnLoadFeatures" Grid.Column="2" Content="加载要素" Width="80" Height="28" Margin="8,0,0,0"
                            Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnLoadFeatures_Click"/>
                </Grid>
                <TextBlock x:Name="TxtFeatureCount" Text="未加载" Foreground="#8B949E" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="批量修改属性" Foreground="#8B949E" FontSize="12" Margin="0,0,0,8"/>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="字段名:" Foreground="#E6EDF3" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboField" Grid.Column="1" Height="28"
                              Foreground="#E6EDF3" Background="#21262D" BorderBrush="#30363D"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="新值:" Foreground="#E6EDF3" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtNewValue" Grid.Column="1" Height="28"
                             Foreground="#E6EDF3" Background="#21262D" BorderBrush="#30363D"
                             Padding="6,2" FontSize="12"/>
                    <Button x:Name="BtnApply" Grid.Column="2" Content="应用" Width="60" Height="28" Margin="8,0,0,0"
                            Background="#238636" Foreground="White" BorderBrush="#2EA043" BorderThickness="1" Click="BtnApply_Click"/>
                </Grid>

                <Border Grid.Row="3" Background="#0D1117" CornerRadius="4" Padding="6">
                    <TextBlock Text="说明: 将所选图层中所有要素的指定字段修改为新值。\n修改会立即写入图层，可通过撤销功能回退。" 
                               Foreground="#8B949E" FontSize="10" TextWrapping="Wrap"/>
                </Border>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <TextBlock x:Name="TxtResult" Foreground="#E6EDF3" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnClose" Content="关闭" Width="70" Height="30"
                    Background="Transparent" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
