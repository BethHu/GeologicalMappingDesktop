<Window x:Class="GeologicalMappingDesktop.SymbolEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="类别符号编辑" Height="735.25" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#C9D1D9"
        ResizeMode="CanResizeWithGrip"
        MinWidth="460" MinHeight="560">
    <Window.Resources>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid Background="Transparent">
                <Path x:Name="Arrow" Data="M0,0 L5,5 L10,0" Stroke="#8B949E" StrokeThickness="1.5"
                      Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </ControlTemplate>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,4,0"/>
                                    <ToggleButton x:Name="DropDownToggle" Grid.Column="1"
                                                  Template="{StaticResource ComboBoxToggleButton}"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Width="16" Height="16" Margin="0,0,2,0"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="3">
                                        <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#30363D" BorderThickness="1,1,1,0"
                                Margin="0,0,2,0" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="LayerOpBtn" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3FB950"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtClassTitle" Grid.Row="0" FontSize="14" FontWeight="Bold"
                   Foreground="#58A6FF" Margin="0,0,0,8"/>

        <TabControl x:Name="SymTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    SelectedIndex="0">

            <!-- 点符号 -->
            <TabItem x:Name="TabPointSym" Header="点符号" Style="{StaticResource DarkTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel>
                        <TextBlock Text="点符号层（自下而上叠加）" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="LstPointLayers" Height="80" Margin="0,0,0,4"
                                 Background="#0D2137" Foreground="#E6EDF3" BorderBrush="#1F6FEB"
                                 DisplayMemberPath="DisplayLabel"
                                 SelectionChanged="LstPointLayers_SelectionChanged"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboAddPointLayer" Height="22" Grid.Column="0" Margin="0,0,4,0"
                                      Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                                <ComboBoxItem Content="简单点符号" Tag="SimpleMarker"/>
                                <ComboBoxItem Content="SVG 符号" Tag="SvgMarker"/>
                                <ComboBoxItem Content="向量场箭头" Tag="VectorField"/>
                                <ComboBoxItem Content="字体符号" Tag="FontMarker"/>
                            </ComboBox>
                            <Button Content="添加" Height="22" Grid.Column="1" Margin="0,0,2,0" Padding="8,0"
                                    Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043"
                                    Click="BtnAddPointLayer_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="删除选中的符号层" Click="BtnRemovePointLayer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontFamily="Segoe UI Symbol" Foreground="#F85149" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="删除" Foreground="#F85149" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="上移：把选中的符号层向上叠放" Click="BtnPointLayerUp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▲" FontFamily="Segoe UI Symbol" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="上移" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="下移：把选中的符号层向下叠放" Click="BtnPointLayerDown_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▼" FontFamily="Segoe UI Symbol" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="下移" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="4" Padding="6" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="ChkPtLayerEnabled" Content="启用" Foreground="#E6EDF3" Margin="0,0,0,6"
                                          Click="PtLayerControl_Changed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="颜色" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border x:Name="BrdPtLayerColor" Width="28" Height="20" Background="#58A6FF"
                                                    BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                            <Button Content="选择" Height="20" Padding="6,0" Style="{StaticResource DarkButton}"
                                                    Click="BtnPtLayerColor_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="大小" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldPtLayerSize" Minimum="2" Maximum="48" Value="10"
                                                    ValueChanged="PtLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtPtLayerSize" Grid.Column="1" Text="10" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="旋转(°)" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldPtLayerAngle" Minimum="0" Maximum="360" Value="0"
                                            ValueChanged="PtLayerControl_Changed"/>
                                    <TextBox x:Name="TxtPtLayerAngle" Grid.Column="1" Height="22" Margin="6,0,0,0"
                                             Text="0" Style="{StaticResource DarkTextBox}"
                                             TextChanged="AngleText_Changed"/>
                                </Grid>

                                <!-- Simple Marker 专属面板 -->
                                <StackPanel x:Name="PanelPtSimpleMarker">
                                    <TextBlock Text="点样式" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboMarkerStyle" Height="26" Margin="0,0,0,6"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="PtLayerControl_Changed"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="描边颜色" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border x:Name="BrdPtLayerOutline" Width="28" Height="20" Background="#FFFFFF"
                                                        BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                                <Button Content="选择" Height="20" Padding="6,0" Style="{StaticResource DarkButton}"
                                                        Click="BtnPtLayerOutline_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="描边宽度" Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="SldPtLayerOutlineWidth" Minimum="0" Maximum="6" Value="0.5" Width="100"
                                                    Margin="0,0,0,6" ValueChanged="PtLayerControl_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- SVG Marker 专属面板 -->
                                <StackPanel x:Name="PanelPtSvgMarker" Visibility="Collapsed">
                                    <TextBlock Text="SVG 文件" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSvgPath" Height="22" Grid.Column="0" Margin="0,0,4,0"
                                                 Style="{StaticResource DarkTextBox}"
                                                 TextChanged="PtLayerControl_Changed"/>
                                        <Button Content="浏览..." Height="22" Grid.Column="1" Padding="8,0"
                                                Style="{StaticResource DarkButton}" Click="BtnBrowseSvg_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Vector Field 专属面板 -->
                                <StackPanel x:Name="PanelPtVectorField" Visibility="Collapsed">
                                    <TextBlock Text="方向字段（倾向）" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboVectorDirField" Height="26" Margin="0,0,0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="PtLayerControl_Changed"/>
                                    <TextBlock Text="大小字段（倾角）" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboVectorMagField" Height="26" Margin="0,0,0,6"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="PtLayerControl_Changed"/>
                                </StackPanel>

                                <!-- Font Marker 专属面板 -->
                                <StackPanel x:Name="PanelPtFontMarker" Visibility="Collapsed">
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboPtFontFamily" Height="26" Margin="0,0,0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="PtLayerControl_Changed"/>
                                    <TextBlock Text="字符" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtPtFontChar" Height="22" Margin="0,0,0,6" MaxLength="2"
                                             Style="{StaticResource DarkTextBox}"
                                             TextChanged="PtLayerControl_Changed"/>
                                </StackPanel>

                                <!-- 短直线/箭头专属面板 -->
                                <StackPanel x:Name="PanelPtLineArrow" Visibility="Collapsed">
                                    <TextBlock Text="长度" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SldPtLineLength" Minimum="4" Maximum="64" Value="20"
                                                TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="PtLayerControl_Changed"/>
                                        <TextBlock x:Name="TxtPtLineLength" Grid.Column="1" Text="20"
                                                   Foreground="#E6EDF3" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 锚点/偏移/缩放（所有点符号层通用） -->
                                <Border Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="位置/缩放（所有点符号层通用）" Foreground="#58A6FF" FontSize="11" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="锚点 X" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtAnchorX" Height="22" Text="0.50"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="PtLayerControl_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="锚点 Y" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtAnchorY" Height="22" Text="0.50"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="PtLayerControl_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="偏移 X (px)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtOffsetX" Height="22" Text="0"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="PtLayerControl_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="偏移 Y (px)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtOffsetY" Height="22" Text="0"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="PtLayerControl_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="缩放倍率" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                <Slider x:Name="SldPtScale" Minimum="0.1" Maximum="5" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                        MinHeight="20" Margin="0,2,0,0"
                                                        ValueChanged="PtLayerControl_Changed"/>
                                                <TextBlock x:Name="TxtPtScale" Grid.Column="1" Text="1.0" Foreground="#E6EDF3"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 线符号 -->
            <TabItem x:Name="TabLineSym" Header="线符号" Style="{StaticResource DarkTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel>
                        <TextBlock Text="线符号层（自下而上叠加）" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="LstLineLayers" Height="70" Margin="0,0,0,4"
                                 Background="#0D2137" Foreground="#E6EDF3" BorderBrush="#1F6FEB"
                                 DisplayMemberPath="DisplayLabel"
                                 SelectionChanged="LstLineLayers_SelectionChanged"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboAddLineLayer" Height="22" Grid.Column="0" Margin="0,0,4,0"
                                      Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                                <ComboBoxItem Content="简单线" Tag="SimpleStroke"/>
                                <ComboBoxItem Content="标记线" Tag="MarkerLine"/>
                                <ComboBoxItem Content="箭头线" Tag="ArrowLine"/>
                                <ComboBoxItem Content="波浪线" Tag="WaveLine"/>
                                <ComboBoxItem Content="锯齿线" Tag="SawtoothLine"/>
                            </ComboBox>
                            <Button Content="添加" Height="22" Grid.Column="1" Margin="0,0,2,0" Padding="8,0"
                                    Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043"
                                    Click="BtnAddLineLayer_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="删除选中的符号层" Click="BtnRemoveLineLayer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontFamily="Segoe UI Symbol" Foreground="#F85149" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="删除" Foreground="#F85149" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="上移：把选中的符号层向上叠放" Click="BtnLineLayerUp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▲" FontFamily="Segoe UI Symbol" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="上移" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="下移：把选中的符号层向下叠放" Click="BtnLineLayerDown_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▼" FontFamily="Segoe UI Symbol" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="下移" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="4" Padding="6" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="ChkLineLayerEnabled" Content="启用" Foreground="#E6EDF3" Margin="0,0,0,6"
                                          Click="LineLayerControl_Changed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="颜色" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border x:Name="BrdLineLayerColor" Width="28" Height="20" Background="#58A6FF"
                                                    BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                            <Button Content="选择" Height="20" Padding="6,0" Style="{StaticResource DarkButton}"
                                                    Click="BtnLineLayerColor_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="线宽" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldLineLayerWidth" Minimum="0.5" Maximum="20" Value="2"
                                                    ValueChanged="LineLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtLineLayerWidth" Grid.Column="1" Text="2.0" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- SimpleStroke 面板 -->
                                <StackPanel x:Name="PanelLineSimpleStroke">
                                    <TextBlock Text="线样式" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboLineStrokeStyle" Height="26" Margin="0,0,0,6"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="LineLayerControl_Changed">
                                        <ComboBoxItem Content="实线" Tag="Solid"/>
                                        <ComboBoxItem Content="虚线" Tag="Dash"/>
                                        <ComboBoxItem Content="点线" Tag="Dot"/>
                                        <ComboBoxItem Content="点划线" Tag="DashDot"/>
                                        <ComboBoxItem Content="点线组合" Tag="DashDotDot"/>
                                        <ComboBoxItem Content="哈希线" Tag="Hash"/>
                                    </ComboBox>
                                    <TextBlock Text="虚线间距" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldLineDashSpacing" Minimum="1" Maximum="20" Value="5"
                                                ValueChanged="LineLayerControl_Changed"/>
                                        <TextBlock x:Name="TxtLineDashSpacing" Grid.Column="1" Text="5" Foreground="#E6EDF3"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- MarkerLine 面板 -->
                                <StackPanel x:Name="PanelLineMarkerLine" Visibility="Collapsed">
                                    <TextBlock Text="沿线等距放置点符号（点符号从点符号编辑器选择）" Style="{StaticResource FieldLabel}"/>
                                    <Button Content="选择点符号..." Height="24" Margin="0,0,0,6" Padding="8,0"
                                            Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                                            ToolTip="打开点符号编辑器，选择要沿线放置的点样式"
                                            Click="BtnLineSelectPointSymbol_Click"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="标记大小" Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="SldLineMarkerSize" Minimum="2" Maximum="24" Value="6"
                                                    Margin="0,0,0,4" ValueChanged="LineLayerControl_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="间距(px)" Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="SldLineMarkerInterval" Minimum="4" Maximum="80" Value="20"
                                                    Margin="0,0,0,4" ValueChanged="LineLayerControl_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="放置方式" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboLineMarkerPlacement" Height="26" Margin="0,0,0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="LineLayerControl_Changed">
                                        <ComboBoxItem Content="沿线均匀放置" Tag="Along"/>
                                        <ComboBoxItem Content="起点" Tag="Begin"/>
                                        <ComboBoxItem Content="终点" Tag="End"/>
                                        <ComboBoxItem Content="起点和终点" Tag="BeginAndEnd"/>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="标记颜色" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <Border x:Name="BrdLineMarkerColor" Width="28" Height="20" Background="#58A6FF"
                                                BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="8,0,6,0"/>
                                        <Button Content="选择" Height="20" Padding="6,0" Style="{StaticResource DarkButton}"
                                                Click="BtnLineMarkerColor_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ArrowLine 面板 -->
                                <StackPanel x:Name="PanelLineArrowLine" Visibility="Collapsed">
                                    <TextBlock Text="箭头放置" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboLineArrowPlacement" Height="26" Margin="0,0,0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="LineLayerControl_Changed">
                                        <ComboBoxItem Content="终点" Tag="End"/>
                                        <ComboBoxItem Content="起点" Tag="Begin"/>
                                        <ComboBoxItem Content="起点和终点" Tag="BeginAndEnd"/>
                                    </ComboBox>
                                    <TextBlock Text="箭头大小" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldLineArrowSize" Minimum="4" Maximum="32" Value="10"
                                                ValueChanged="LineLayerControl_Changed"/>
                                        <TextBlock x:Name="TxtLineArrowSize" Grid.Column="1" Text="10" Foreground="#E6EDF3"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- WaveLine / SawtoothLine 面板 -->
                                <StackPanel x:Name="PanelLineWave" Visibility="Collapsed">
                                    <TextBlock Text="波幅" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldLineWaveAmplitude" Minimum="2" Maximum="40" Value="8"
                                                ValueChanged="LineLayerControl_Changed"/>
                                        <TextBlock x:Name="TxtLineWaveAmplitude" Grid.Column="1" Text="8" Foreground="#E6EDF3"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                    <TextBlock Text="波长" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldLineWaveLength" Minimum="4" Maximum="60" Value="20"
                                                ValueChanged="LineLayerControl_Changed"/>
                                        <TextBlock x:Name="TxtLineWaveLength" Grid.Column="1" Text="20" Foreground="#E6EDF3"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 锚点/偏移/缩放（所有线符号层通用） -->
                                <Border Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="位置/缩放（所有线符号层通用；缩放=线宽×倍率，偏移对标记点符号有效）" Foreground="#58A6FF" FontSize="11" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="锚点 X" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtLineAnchorX" Height="22" Text="0.50"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="LineLayerControl_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="锚点 Y" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtLineAnchorY" Height="22" Text="0.50"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="LineLayerControl_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="偏移 X (px)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtLineOffsetX" Height="22" Text="0"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="LineLayerControl_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="偏移 Y (px)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtLineOffsetY" Height="22" Text="0"
                                                         Style="{StaticResource DarkTextBox}"
                                                         TextChanged="LineLayerControl_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="缩放倍率" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                <Slider x:Name="SldLineScale" Minimum="0.1" Maximum="5" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                        MinHeight="20" Margin="0,2,0,0"
                                                        ValueChanged="LineLayerControl_Changed"/>
                                                <TextBlock x:Name="TxtLineScale" Grid.Column="1" Text="1.0" Foreground="#E6EDF3"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 面符号（与点/线符号编辑器结构相同：多层叠加） -->
            <TabItem x:Name="TabFillSym" Header="面符号" Style="{StaticResource DarkTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel>
                        <TextBlock Text="填充符号层（自下而上叠加）" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="LstFillLayers" Height="70" Margin="0,0,0,4"
                                 Background="#0D2137" Foreground="#E6EDF3" BorderBrush="#1F6FEB"
                                 DisplayMemberPath="DisplayLabel"
                                 SelectionChanged="LstFillLayers_SelectionChanged"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboAddFillLayer" Height="22" Grid.Column="0" Margin="0,0,4,0"
                                      Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                                <ComboBoxItem Content="实心底色" Tag="Solid"/>
                                <ComboBoxItem Content="平行线" Tag="Lines"/>
                                <ComboBoxItem Content="交叉线" Tag="CrossHatch"/>
                                <ComboBoxItem Content="点阵" Tag="PointsGrid"/>
                                <ComboBoxItem Content="随机点" Tag="PointsRandom"/>
                                <ComboBoxItem Content="箭头" Tag="Arrows"/>
                                <ComboBoxItem Content="SVG/图片" Tag="SvgOrImage"/>
                                <ComboBoxItem Content="渐变填充" Tag="Gradient"/>
                            </ComboBox>
                            <Button Content="添加" Height="22" Grid.Column="1" Margin="0,0,2,0" Padding="8,0"
                                    Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043"
                                    Click="BtnAddFillLayer_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="删除选中的符号层" Click="BtnRemoveFillLayer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontFamily="Segoe UI Symbol" Foreground="#F85149" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="删除" Foreground="#F85149" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="上移：把选中的符号层向上叠放" Click="BtnFillLayerUp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▲" FontFamily="Segoe UI Symbol" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="上移" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource LayerOpBtn}"
                                    ToolTip="下移：把选中的符号层向下叠放" Click="BtnFillLayerDown_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▼" FontFamily="Segoe UI Symbol" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="下移" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 层属性 -->
                        <Border Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="4" Padding="6" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="ChkLayerEnabled" Content="启用" Foreground="#E6EDF3" Margin="0,0,0,6"
                                          Click="FillLayerControl_Changed"/>
                                <!-- 颜色独占一行 -->
                                <StackPanel Margin="0,0,0,4" x:Name="PanelFillColor">
                                    <TextBlock Text="颜色" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border x:Name="BrdLayerColor" Width="28" Height="20" Background="#58A6FF"
                                                BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                        <Button Content="选择" Height="20" Padding="6,0" Style="{StaticResource DarkButton}"
                                                Click="BtnLayerColor_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 不透明度 + 大小 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0" x:Name="PanelFillOpacity">
                                        <TextBlock Text="不透明度" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldLayerOpacity" Minimum="0" Maximum="100" Value="100"
                                                    ValueChanged="FillLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtLayerOpacity" Grid.Column="1" Text="100%" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0" x:Name="PanelFillSize">
                                        <TextBlock Text="大小" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldLayerSize" Minimum="0.5" Maximum="32" Value="2"
                                                    ValueChanged="FillLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtLayerSize" Grid.Column="1" Text="2.0" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- 角度 + 间距 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="角度" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldLayerAngle" Minimum="0" Maximum="180" Value="45"
                                                    ValueChanged="FillLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtLayerAngle" Grid.Column="1" Text="45" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="间距" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldLayerSpacing" Minimum="2" Maximum="48" Value="10"
                                                    ValueChanged="FillLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtLayerSpacing" Grid.Column="1" Text="10" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- 偏移 X + 偏移 Y -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="偏移 X" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldLayerOffX" Minimum="-20" Maximum="20" Value="0"
                                                    ValueChanged="FillLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtLayerOffX" Grid.Column="1" Text="0" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="偏移 Y" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SldLayerOffY" Minimum="-20" Maximum="20" Value="0"
                                                    ValueChanged="FillLayerControl_Changed"/>
                                            <TextBlock x:Name="TxtLayerOffY" Grid.Column="1" Text="0" Foreground="#E6EDF3"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- 密度（仅 Arrows 可见） -->
                                <StackPanel x:Name="PanelFillDensity" Visibility="Collapsed" Margin="0,0,0,4">
                                    <TextBlock Text="密度" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldLayerDensity" Minimum="0.2" Maximum="3" Value="1"
                                                ValueChanged="FillLayerControl_Changed"/>
                                        <TextBlock x:Name="TxtLayerDensity" Grid.Column="1" Text="1.0" Foreground="#E6EDF3"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 线样式选择（Lines / CrossHatch / Arrows） -->
                                <StackPanel x:Name="PanelFillLineStyle" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock Text="线图案样式（从线符号编辑器选择）" Foreground="#58A6FF" FontSize="11" Margin="0,0,0,4"/>
                                    <Button Content="选择线样式..." Height="24" Padding="8,0"
                                            Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                                            Click="BtnFillSelectLineStyle_Click"/>
                                </StackPanel>

                                <!-- 点样式选择（PointsGrid / PointsRandom） -->
                                <StackPanel x:Name="PanelFillPointStyle" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock Text="点图案样式（从点符号编辑器选择）" Foreground="#58A6FF" FontSize="11" Margin="0,0,0,4"/>
                                    <Button Content="选择点样式..." Height="24" Padding="8,0"
                                            Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                                            Click="BtnFillSelectPointStyle_Click"/>
                                </StackPanel>

                                <!-- SVG 文件浏览 -->
                                <StackPanel x:Name="PanelFillSvg" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock Text="SVG/图片文件" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtFillSvgPath" Height="22" Grid.Column="0" Margin="0,0,4,0"
                                                 Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                                 TextChanged="FillLayerControl_Changed"/>
                                        <Button Content="浏览..." Height="22" Grid.Column="1" Padding="8,0"
                                                Style="{StaticResource DarkButton}" Click="BtnFillBrowseSvg_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 渐变填充 -->
                                <StackPanel x:Name="PanelFillGradient" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock Text="渐变类型" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboGradientType" Height="26" Margin="0,0,0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="FillLayerControl_Changed">
                                        <ComboBoxItem Content="线性渐变" Tag="Linear"/>
                                        <ComboBoxItem Content="径向渐变" Tag="Radial"/>
                                    </ComboBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="起始颜色" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border x:Name="BrdGradientColor1" Width="28" Height="20" Background="#58A6FF"
                                                        BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                                <Button Content="选择" Height="20" Padding="6,0" Style="{StaticResource DarkButton}"
                                                        Click="BtnGradientColor1_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="结束颜色" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border x:Name="BrdGradientColor2" Width="28" Height="20" Background="#FFFFFF"
                                                        BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                                <Button Content="选择" Height="20" Padding="6,0" Style="{StaticResource DarkButton}"
                                                        Click="BtnGradientColor2_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Rectangle Height="1" Fill="#30363D" Margin="0,0,0,8"/>
                        <TextBlock Text="轮廓颜色" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border x:Name="BrdOutlineColor" Width="36" Height="28" Background="#58A6FF"
                                    BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,8,0"/>
                            <Button Content="选择颜色..." Height="28" Padding="10,0" Style="{StaticResource DarkButton}"
                                    Click="BtnOutlineColor_Click"/>
                        </StackPanel>
                        <TextBlock Text="轮廓宽度" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="SldOutlineWidth" Minimum="0" Maximum="12" Value="1" Margin="0,0,0,8"
                                ValueChanged="FillLayerControl_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 预览 -->
        <Border Grid.Row="1" Background="#0D2137" BorderBrush="#30363D" BorderThickness="1"
                CornerRadius="4" MinHeight="70" VerticalAlignment="Bottom" Margin="0,0,0,4">
            <Grid>
                <TextBlock Text="符号预览" Foreground="#484F58" HorizontalAlignment="Center"
                           VerticalAlignment="Top" Margin="0,4,0,0" FontSize="11"/>
                <Canvas x:Name="SymbolPreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="240" Height="60"/>
                <Image x:Name="ImgPatternPreview" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Width="200" Height="50" Stretch="UniformToFill" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,8,0"
                    Background="#238636" Foreground="White" BorderBrush="#2EA043"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="30"
                    Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>