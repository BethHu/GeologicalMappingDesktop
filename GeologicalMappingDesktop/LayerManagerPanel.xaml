<UserControl x:Class="GeologicalMappingDesktop.LayerManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeologicalMappingDesktop"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="280"
             Background="#161B22">
    <UserControl.Resources>
        <local:ExpandIconConverter x:Key="ExpandIconConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:GroupPrefixConverter x:Key="GroupPrefixConverter"/>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6FEB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                                      IsHitTestVisible="False"
                                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#8B949E"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="4" Padding="2" MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView 展开箭头 -->
        <Style x:Key="TreeViewExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow" Data="M0,2 L4,6 L0,10 Z" Fill="#8B949E"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M2,0 L6,4 L10,0 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem 容器样式（Windows 资源管理器风格） -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource TreeViewExpanderStyle}"/>
                            <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}"
                                    Padding="2,2" CornerRadius="4">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6FEB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文件夹节点模板（Windows 资源管理器风格） -->
        <HierarchicalDataTemplate DataType="{x:Type local:LayerFolderNode}" ItemsSource="{Binding Children}">
            <Border Background="Transparent" Padding="4,3" MinHeight="26">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FolderIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#E6EDF3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="#8B949E"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>

        <!-- 图层叶子节点模板 -->
        <DataTemplate DataType="{x:Type local:LayerItem}">
            <StackPanel>
                <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="2,3">
                    <Border.ContextMenu>
                        <ContextMenu Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D">
                            <MenuItem Header="属性..." Click="LayerProperties_Click"
                                      Background="Transparent" Foreground="#E6EDF3"/>
                            <Separator/>
                            <MenuItem Header="移动到分组" Background="Transparent" Foreground="#E6EDF3"
                                      Tag="{Binding}" Click="MoveToGroup_Click"
                                      ItemsSource="{Binding MoveDestinations}" DisplayMemberPath="Header">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Background" Value="#21262D"/>
                                        <Setter Property="Foreground" Value="#E6EDF3"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#1F6FEB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="按类型自动分类" Click="ResetAutoClassification_Click"
                                      Background="Transparent" Foreground="#E6EDF3"/>
                            <Separator/>
                            <MenuItem Header="导出为 Shapefile" Tag="shp" Click="ExportLayer_Click"
                                      Background="Transparent" Foreground="#E6EDF3"/>
                            <MenuItem Header="导出为 GeoPackage" Tag="gpkg" Click="ExportLayer_Click"
                                      Background="Transparent" Foreground="#E6EDF3"/>
                            <MenuItem Header="导出为 GeoTIFF" Tag="tif" Click="ExportLayer_Click"
                                      Background="Transparent" Foreground="#E6EDF3"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <!-- 展开/折叠 -->
                        <Button Grid.Column="0" 
                                Content="{Binding IsExpanded, Converter={StaticResource ExpandIconConverter}}"
                                FontSize="10" Foreground="#8B949E"
                                Background="Transparent" BorderThickness="0"
                                Click="ToggleExpand_Click" Tag="{Binding}"
                                ToolTip="展开分类"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="20" Height="20" Padding="0"
                                Style="{StaticResource IconBtnStyle}"/>
                        <!-- 可见性 -->
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsVisible}"
                                  Checked="LayerVisible_Checked"
                                  Unchecked="LayerVisible_Unchecked"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Style="{StaticResource LayerCheckboxStyle}"/>
                        <!-- 图层名称 -->
                        <Grid Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="{Binding Name}" 
                                       FontSize="12" 
                                       Foreground="#E6EDF3"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"/>
                            <TextBlock Text="*" 
                                       FontSize="14" 
                                       Foreground="#F85149"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,2,0"
                                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <!-- 编辑 -->
                        <Button Grid.Column="3" 
                                Content="{Binding IsEditable, Converter={StaticResource EditableIconConverter}}"
                                Foreground="{Binding IsEditable, Converter={StaticResource EditableColorConverter}}"
                                FontSize="14"
                                Background="Transparent" BorderThickness="0"
                                Click="ToggleEdit_Click" Tag="{Binding}"
                                ToolTip="{Binding IsEditable, Converter={StaticResource EditableTooltipConverter}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="20" Height="20"
                                Style="{StaticResource IconBtnStyle}"/>
                        <!-- 缩放 -->
                        <Button Grid.Column="4" Content="🔍" 
                                FontSize="11" Foreground="#58A6FF"
                                Background="Transparent" BorderThickness="0"
                                Click="ZoomToLayer_Click" Tag="{Binding Name}"
                                ToolTip="缩放至图层"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="20" Height="20"
                                Style="{StaticResource IconBtnStyle}"/>
                        <!-- 属性表 -->
                        <Button Grid.Column="5" Content="📋" 
                                FontSize="11" Foreground="#A371F7"
                                Background="Transparent" BorderThickness="0"
                                Click="ShowAttributeTable_Click" Tag="{Binding Name}"
                                ToolTip="属性表"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="20" Height="20"
                                Style="{StaticResource IconBtnStyle}"/>
                        <!-- 移除 -->
                        <Button Grid.Column="6" Content="✕" 
                                FontSize="11" Foreground="#F85149"
                                Background="Transparent" BorderThickness="0"
                                Click="RemoveButton_Click" Tag="{Binding Name}"
                                ToolTip="移除图层"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="20" Height="20"
                                Style="{StaticResource IconBtnStyle}"/>
                        <!-- 上移 -->
                        <Button Grid.Column="7" Content="▲" 
                                FontSize="8" Foreground="#58A6FF"
                                Background="Transparent" BorderThickness="0"
                                Click="MoveUp_Click" Tag="{Binding}"
                                ToolTip="上移"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="16" Height="16" Padding="0"
                                Style="{StaticResource IconBtnStyle}"/>
                        <!-- 下移 -->
                        <Button Grid.Column="8" Content="▼" 
                                FontSize="8" Foreground="#58A6FF"
                                Background="Transparent" BorderThickness="0"
                                Click="MoveDown_Click" Tag="{Binding}"
                                ToolTip="下移"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="16" Height="16" Padding="0"
                                Style="{StaticResource IconBtnStyle}"/>
                    </Grid>
                </Border>
                <!-- 分类展开项 -->
                <ItemsControl ItemsSource="{Binding ClassificationItems}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="24,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C2128" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="4,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="8"
                                            Background="{Binding ColorBrush}"
                                            BorderBrush="#58A6FF" BorderThickness="0.5"
                                            Margin="0,2,4,2" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10"
                                               Foreground="#8B949E" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 底图选择 -->
        <Border Grid.Row="0" BorderBrush="#30363D" BorderThickness="0,0,0,1" Background="#0D1117" Padding="8,8,8,6">
            <StackPanel>
                <TextBlock Text="底图" Foreground="#8B949E" FontSize="10" Margin="0,0,0,4"/>
                <ComboBox x:Name="CboBasemap" Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="CboBasemap_SelectionChanged">
                    <ComboBoxItem Content="卫星影像" Tag="Imagery" IsSelected="True"/>
                    <ComboBoxItem Content="白色底图" Tag="LightGray"/>
                    <ComboBoxItem Content="街道图" Tag="Streets"/>
                    <ComboBoxItem Content="地形图" Tag="Topographic"/>
                    <ComboBoxItem Content="暗色底图" Tag="DarkGray"/>
                    <ComboBoxItem Content="航海图" Tag="Oceans"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- 图层文件夹树（Windows 资源管理器风格） -->
        <TreeView x:Name="LayerTree" 
                  Grid.Row="1" 
                  Margin="0"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectedItemChanged="LayerTree_SelectedItemChanged"
                  MouseDoubleClick="LayerTree_MouseDoubleClick">
            <TreeView.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Background" Value="#161B22"/>
                    <Setter Property="Foreground" Value="#30363D"/>
                </Style>
            </TreeView.Resources>
        </TreeView>

        <!-- 底部操作按钮 -->
        <Border Grid.Row="2" BorderBrush="#30363D" BorderThickness="0,1,0,0" Background="#0D1117" Padding="6,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnNewLayer" 
                        Content="新建" FontSize="11" Height="26"
                        Foreground="#238636" Background="#0D1117"
                        BorderBrush="#238636" BorderThickness="1"
                        Click="BtnNewLayer_Click" Margin="2,0"
                        Cursor="Hand" Padding="10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#238636"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnSaveLayer" 
                        Content="保存" FontSize="11" Height="26"
                        Foreground="#58A6FF" Background="#0D1117"
                        BorderBrush="#58A6FF" BorderThickness="1"
                        Click="BtnSaveLayer_Click" Margin="2,0"
                        Cursor="Hand" Padding="10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#58A6FF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnClearAll" 
                        Content="清空" FontSize="11" Height="26"
                        Foreground="#F85149" Background="#0D1117"
                        BorderBrush="#F85149" BorderThickness="1"
                        Click="BtnClearAll_Click" Margin="2,0"
                        Cursor="Hand" Padding="10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F85149"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
