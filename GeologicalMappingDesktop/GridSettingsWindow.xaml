<Window x:Class="GeologicalMappingDesktop.GridSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="地图网格设置" Height="718" Width="400"
        WindowStartupLocation="CenterOwner" Background="#0D1117" Foreground="#E6EDF3"
        TextElement.FontSize="13">
    <ScrollViewer Margin="12">
        <StackPanel>
            <CheckBox x:Name="ChkEnabled" Content="启用网格" FontWeight="Bold" Margin="0,0,0,12"
                      Foreground="#E6EDF3" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>

            <GroupBox Header="显示模式" Foreground="#8B949E" BorderBrush="#30363D" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <RadioButton x:Name="RbBoth" GroupName="DisplayMode" Content="网格 + 标注" Foreground="#E6EDF3" Margin="0,2" Checked="DisplayMode_Changed"/>
                    <RadioButton x:Name="RbGridOnly" GroupName="DisplayMode" Content="仅网格" Foreground="#E6EDF3" Margin="0,2" Checked="DisplayMode_Changed"/>
                    <RadioButton x:Name="RbLabelOnly" GroupName="DisplayMode" Content="仅标注" Foreground="#E6EDF3" Margin="0,2" Checked="DisplayMode_Changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="间隔" Foreground="#8B949E" BorderBrush="#30363D" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <RadioButton x:Name="RbIntervalAuto" GroupName="IntervalMode" Content="自动" Foreground="#E6EDF3" Margin="0,2" Checked="IntervalMode_Changed"/>
                    <RadioButton x:Name="RbIntervalFixed" GroupName="IntervalMode" Content="固定" Foreground="#E6EDF3" Margin="0,2" Checked="IntervalMode_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="20,4,0,4" IsEnabled="False">
                        <Label Content="值:" Foreground="#E6EDF3" Padding="0"/>
                        <TextBox x:Name="TxtInterval" Width="80" Text="1.0" VerticalAlignment="Center" Margin="8,0,0,0"
                                 Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3"
                                 TextChanged="TxtInterval_Changed"/>
                        <Label Content="度" Foreground="#8B949E" Padding="4,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="网格样式" Foreground="#8B949E" BorderBrush="#30363D" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Label Content="颜色:" Foreground="#E6EDF3" Width="60"/>
                        <Border BorderBrush="#30363D" BorderThickness="1" Width="28" Height="28" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="ClrLinePreview" Background="#646464" Width="24" Height="24"/>
                        </Border>
                        <Button Content="选择..." Margin="8,0,0,0" Padding="8,2" Click="PickLineColor_Click"
                                Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="线宽:" Foreground="#E6EDF3" Width="60"/>
                        <TextBox x:Name="TxtLineWidth" Width="60" Text="0.5" VerticalAlignment="Center"
                                 Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3"
                                 TextChanged="TxtLineWidth_Changed"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="标注样式" Foreground="#8B949E" BorderBrush="#30363D" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Label Content="字号:" Foreground="#E6EDF3" Width="60"/>
                        <TextBox x:Name="TxtFontSize" Width="60" Text="10" VerticalAlignment="Center"
                                 Background="#161B22" BorderBrush="#30363D" Foreground="#E6EDF3"
                                 TextChanged="TxtFontSize_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="颜色:" Foreground="#E6EDF3" Width="60"/>
                        <Border BorderBrush="#30363D" BorderThickness="1" Width="28" Height="28" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="ClrFontPreview" Background="#3C3C3C" Width="24" Height="24"/>
                        </Border>
                        <Button Content="选择..." Margin="8,0,0,0" Padding="8,2" Click="PickFontColor_Click"
                                Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkBold" Content="粗体" Foreground="#E6EDF3" Margin="0,2" Checked="FontStyle_Changed" Unchecked="FontStyle_Changed"/>
                    <CheckBox x:Name="ChkItalic" Content="斜体" Foreground="#E6EDF3" Margin="0,2" Checked="FontStyle_Changed" Unchecked="FontStyle_Changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="标注边" Foreground="#8B949E" BorderBrush="#30363D" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <CheckBox x:Name="ChkTop" Content="上边" Foreground="#E6EDF3" Margin="0,2" Checked="Side_Changed" Unchecked="Side_Changed"/>
                    <CheckBox x:Name="ChkBottom" Content="下边" Foreground="#E6EDF3" Margin="0,2" Checked="Side_Changed" Unchecked="Side_Changed"/>
                    <CheckBox x:Name="ChkLeft" Content="左边" Foreground="#E6EDF3" Margin="0,2" Checked="Side_Changed" Unchecked="Side_Changed"/>
                    <CheckBox x:Name="ChkRight" Content="右边" Foreground="#E6EDF3" Margin="0,2" Checked="Side_Changed" Unchecked="Side_Changed"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="关闭" Padding="16,6" IsCancel="True"
                        Background="#21262D" BorderBrush="#30363D" Foreground="#E6EDF3"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>