<Window x:Class="GeologicalMappingDesktop.FeatureAttributeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="要素属性" Height="400" Width="500"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AttributePanel" Orientation="Vertical" />
        </ScrollViewer>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="BtnCancel" Content="取消" Width="70" Height="30" Click="BtnCancel_Click"/>
            <Button x:Name="BtnOK" Content="确定" Width="70" Height="30" Click="BtnOK_Click"/>
        </StackPanel>
    </Grid>
</Window>