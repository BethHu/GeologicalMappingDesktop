<Window x:Class="GeologicalMappingDesktop.PhotoManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片管理器" Height="650" Width="976"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        FontFamily="Microsoft YaHei"
        MinWidth="800" MinHeight="450">
    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DarkBorder" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#238636"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
            </Style.Resources>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Category: 照片 / 草图 -->
        <Border Grid.Row="0" Style="{StaticResource DarkBorder}" Padding="8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnTabPhoto" Content="📷 照片" Style="{StaticResource TabButton}"
                        Background="#238636" Foreground="White"
                        Click="BtnTabPhoto_Click"/>
                <Button x:Name="BtnTabSketch" Content="✏️ 草图" Style="{StaticResource TabButton}"
                        Background="#21262D" Foreground="#8B949E" Margin="6,0,0,0"
                        Click="BtnTabSketch_Click"/>
                <Button x:Name="BtnTabVideo" Content="🎬 视频" Style="{StaticResource TabButton}"
                        Background="#21262D" Foreground="#8B949E" Margin="6,0,0,0"
                        Click="BtnTabVideo_Click"/>
            </StackPanel>
        </Border>

        <!-- Filter -->
        <Border Grid.Row="1" Style="{StaticResource DarkBorder}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="归档筛选" Style="{StaticResource HeaderLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="归档方式:" Foreground="#E6EDF3" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboGroupMode" Grid.Column="1" Width="100" Height="28" Margin="0,0,8,0"
                              Foreground="#E6EDF3" Background="#21262D" BorderBrush="#30363D"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              SelectionChanged="CboGroupMode_SelectionChanged">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#21262D"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6EDF3"/>
                        </ComboBox.Resources>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="筛选:" Foreground="#E6EDF3" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboFilter" Grid.Column="3" Width="180" Height="28"
                              Foreground="#E6EDF3" Background="#21262D" BorderBrush="#30363D"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              SelectionChanged="CboFilter_SelectionChanged">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#21262D"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6EDF3"/>
                        </ComboBox.Resources>
                    </ComboBox>
                    <Button x:Name="BtnRefresh" Grid.Column="4" Content="刷新" Width="70" Height="28" Margin="8,0,0,0"
                            Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnOpenFolder" Grid.Column="5" Content="打开文件夹" Width="80" Height="28" Margin="4,0,0,0"
                            Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnOpenFolder_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main: list and preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Media list -->
            <Border Grid.Column="0" Style="{StaticResource DarkBorder}" Padding="8" HorizontalAlignment="Left" Width="579">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtListTitle" Text="照片列表" Style="{StaticResource HeaderLabel}"/>
                    <ListBox x:Name="PhotoList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="PhotoList_SelectionChanged" Margin="0,0,47,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Foreground="#E6EDF3" FontSize="11" Padding="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Background="#21262D" HorizontalAlignment="Stretch" Margin="588,0,0,0" RenderTransformOrigin="0.5,0.5">
                <GridSplitter.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </GridSplitter.RenderTransform>
            </GridSplitter>

            <!-- Preview -->
            <Border Style="{StaticResource DarkBorder}" Padding="8" Margin="533,0,0,0" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtPhotoInfo" Text="选择文件查看" Style="{StaticResource HeaderLabel}"/>
                    <Border Grid.Row="1" Background="#0D1117" CornerRadius="4">
                        <Grid>
                            <Image x:Name="PhotoPreview" Stretch="Uniform" Margin="4"/>
                            <MediaElement x:Name="VideoPlayer" Stretch="Uniform" Margin="4"
                                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          MediaEnded="VideoPlayer_MediaEnded"
                                          MediaFailed="VideoPlayer_MediaFailed"
                                          Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtVideoPlaceholder" Text="🎬 选择视频后点击「播放」"
                                       Foreground="#8B949E" FontSize="14" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="重命名" Width="70" Height="26" Margin="2"
                                Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnRename_Click"/>
                        <Button Content="关联点位" Width="70" Height="26" Margin="2"
                                Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnLinkPoint_Click"/>
                        <Button x:Name="BtnPlayVideo" Content="播放" Width="70" Height="26" Margin="2"
                                Background="#238636" Foreground="White" BorderBrush="#2EA043" BorderThickness="1"
                                Click="BtnPlayVideo_Click" Visibility="Collapsed"/>
                        <Button x:Name="BtnStopVideo" Content="停止" Width="70" Height="26" Margin="2"
                                Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1"
                                Click="BtnStopVideo_Click" Visibility="Collapsed"/>
                        <Button Content="导出" Width="70" Height="26" Margin="2"
                                Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" Click="BtnExportPhoto_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: Summary -->
        <Border Grid.Row="3" Style="{StaticResource DarkBorder}" Padding="8" Margin="0,8,0,0">
            <TextBlock x:Name="TxtSummary" Text="加载中..." Foreground="#8B949E" FontSize="11"/>
        </Border>
    </Grid>
</Window>