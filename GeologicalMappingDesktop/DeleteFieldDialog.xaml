<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GeologicalMappingDesktop.DeleteFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除字段" Height="450" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CheckBoxItemStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#58A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="FieldItemTemplate">
            <CheckBox Content="{Binding DisplayName}" 
                      IsChecked="{Binding IsSelected}"
                      Style="{StaticResource CheckBoxItemStyle}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#21262D" CornerRadius="8" Padding="16" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="选择要删除的字段" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="提示：系统字段（FID、OBJECTID）无法删除" Foreground="#F85149" FontSize="11" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <Border Background="#21262D" CornerRadius="8" Padding="4" Grid.Row="1" Margin="0,12,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <ItemsControl x:Name="FieldList" ItemTemplate="{StaticResource FieldItemTemplate}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
            <Button x:Name="BtnCancel" Content="取消" Width="90" Height="32" Margin="0,0,10,0"
                    Click="BtnCancel_Click"
                    Background="Transparent" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="BtnDelete" Content="删除" Width="90" Height="32"
                    Click="BtnDelete_Click"
                    Background="#F85149" Foreground="White" BorderBrush="#F85149" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DA3633"/>
                                <Setter Property="BorderBrush" Value="#DA3633"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#6E7681"/>
                                <Setter Property="BorderBrush" Value="#6E7681"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>