<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GeologicalMappingDesktop.TopologyCheckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="#161B22">
    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1C2333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="12,8,0,4" FontSize="14" FontWeight="Bold" Foreground="#E6EDF3">拓扑检查</TextBlock>

        <Border Grid.Row="1" Margin="8" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Width="80" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center">检查范围</TextBlock>
                    <ComboBox x:Name="CboCheckScope" Width="160" Background="#21262D" Foreground="#E6EDF3" 
                              BorderBrush="#30363D" BorderThickness="1"
                              SelectionChanged="CboCheckScope_SelectionChanged">
                        <ComboBoxItem Content="全图" Tag="AllLayers"/>
                        <ComboBoxItem Content="选中区域" Tag="SelectedArea"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="80" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center">容差阈值</TextBlock>
                    <TextBox x:Name="TxtTolerance" Width="100" FontSize="12" Text="0.001" 
                             Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" 
                             BorderThickness="1" Padding="4"/>
                    <TextBlock Width="60" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" TextAlignment="Right">米</TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnCheckDangling" Style="{StaticResource ToolbarButtonStyle}" 
                    ToolTip="悬挂点检查" Click="BtnCheckDangling_Click">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🔗" FontSize="20"/>
                    <TextBlock Text="悬挂点" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnCheckOverlap" Style="{StaticResource ToolbarButtonStyle}" 
                    ToolTip="重叠检查" Click="BtnCheckOverlap_Click">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🔲" FontSize="20"/>
                    <TextBlock Text="重叠" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnCheckGap" Style="{StaticResource ToolbarButtonStyle}" 
                    ToolTip="缝隙检查" Click="BtnCheckGap_Click">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🕳️" FontSize="20"/>
                    <TextBlock Text="缝隙" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnCheckSelfIntersect" Style="{StaticResource ToolbarButtonStyle}" 
                    ToolTip="自相交检查" Click="BtnCheckSelfIntersect_Click">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🌀" FontSize="20"/>
                    <TextBlock Text="自相交" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="3" Margin="8" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                    <TextBlock FontSize="12" Foreground="#8B949E" Margin="4,0,0,0">错误列表</TextBlock>
                    <TextBlock x:Name="TxtErrorCount" FontSize="12" Foreground="#F85149" Margin="4,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="ErrorDataGrid" AutoGenerateColumns="False" 
                          Background="#161B22" Foreground="#E6EDF3"
                          RowBackground="#161B22" AlternatingRowBackground="#21262D"
                          GridLinesVisibility="None" BorderBrush="#30363D"
                          SelectionMode="Single" SelectionChanged="ErrorDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型" Width="60" Binding="{Binding ErrorTypeText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding ErrorLevelColor}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="图层" Width="80" Binding="{Binding LayerName}"/>
                        <DataGridTextColumn Header="描述" Width="*" Binding="{Binding Description}"/>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="BtnLocate_Click"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="14" Content="📍"
                                                Cursor="Hand" ToolTip="定位"/>
                                        <Button Click="BtnIgnore_Click"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="14" Content="❌"
                                                Cursor="Hand" ToolTip="忽略"/>
                                        <Button Click="BtnFix_Click"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="14" Content="🔧"
                                                Cursor="Hand" ToolTip="自动修复"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnExportCSV" Style="{StaticResource ActionButtonStyle}" Content="导出报告" 
                    Click="BtnExportCSV_Click"/>
            <Button x:Name="BtnClearAll" Style="{StaticResource ActionButtonStyle}" Content="清除列表" 
                    Click="BtnClearAll_Click"/>
        </StackPanel>
    </Grid>
</UserControl>