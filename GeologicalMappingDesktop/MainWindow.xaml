<Window x:Class="GeologicalMappingDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        xmlns:local="clr-namespace:GeologicalMappingDesktop"
        Title="地质填图桌面系统" Height="900" Width="1400" WindowState="Maximized"
        FontFamily="Microsoft YaHei"
        Background="#0D1117">
    <Window.Resources>
        <!-- ========== 深色科技感全局样式 ========== -->

        <!-- 1. TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="SimSun, SimHei, Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="8" 
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3FB950"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#0D1117"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="SimSun, SimHei, Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox" 
                                             Grid.Column="0" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             Margin="4,0" 
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Margin="4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"/>
                                    <Path x:Name="Arrow" 
                                          Grid.Column="1" 
                                          Data="M0,0 L4,4 L8,0 Z" 
                                          Fill="#8B949E" 
                                          Margin="0,0,10,0" 
                                          HorizontalAlignment="Right" 
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" 
                                   Placement="Bottom" 
                                   StaysOpen="False" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#161B22" 
                                        BorderBrush="#30363D" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="480">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3FB950"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#0D1117"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="SimSun, SimHei, Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EA043"/>
                                <Setter Property="BorderBrush" Value="#2EA043"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A7F2E"/>
                                <Setter Property="BorderBrush" Value="#1A7F2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="BorderBrush" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Label -->
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="SimSun, SimHei, Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 5. CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="SimSun, SimHei, Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBorder" 
                                    Grid.Column="0" 
                                    Width="18" Height="18" 
                                    Background="#161B22" 
                                    BorderBrush="#30363D" 
                                    BorderThickness="1.5" 
                                    CornerRadius="4" 
                                    Margin="0,0,8,0">
                                <Path x:Name="checkMark" 
                                      Data="M0,4 L3,8 L8,1" 
                                      Stroke="#FFFFFF" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" 
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" 
                                              VerticalAlignment="Center" 
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="Background" Value="#2EA043"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#2EA043"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B949E"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#0D1117"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 6. 模块导航样式（统一分组，选中高亮，卡片式） -->
        <Style x:Key="ModuleButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="#161B22"
                                CornerRadius="14"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="CardGlow" BlurRadius="18" ShadowDepth="0" Color="#3FB950" Opacity="0"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="#21262D" CornerRadius="14" Opacity="0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AccentBar" Grid.Column="0" Width="3" Background="#3FB950" CornerRadius="1.5" Opacity="0" VerticalAlignment="Stretch"/>
                                    <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Background.Color" To="#1B2B20" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Background.Color" To="#161B22" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 7. 工具栏按钮（macOS 风格：悬停胶囊 + 柔光过渡） -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverPill"
                                    Background="#30363D"
                                    CornerRadius="16"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PillShadow" BlurRadius="14" ShadowDepth="0" Color="#3FB950" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="PillShadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)" To="#3FB950" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="PillShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)" To="#E6EDF3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#30363D"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 9. 面板标题 -->
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3FB950"/>
            <Setter Property="Margin" Value="12,16,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#3FB950" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 9a. 模块导航卡片文字样式 -->
        <Style x:Key="ModuleTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>
        <Style x:Key="ModuleSubStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ModuleIconStyle" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#1F2729"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#3FB950" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 10. TabControl / TabItem 深色主题 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="#30363D" BorderThickness="0,0,1,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0D1117"/>
                                <Setter Property="Foreground" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 工具栏 ========== -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="Transparent" Padding="8,6" Margin="0,0,0,4">
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="14" Padding="4,2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="新建项目" Click="BtnNewProject_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="新建" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="打开项目" Click="BtnOpenProject_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="打开" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="保存项目" Click="BtnSaveProject_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="保存" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="添加数据" Click="BtnAddData_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="添加" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="放大" Click="BtnZoomIn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="放大" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="缩小" Click="BtnZoomOut_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="缩小" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="全图" Click="BtnZoomToFullExtent_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="全图" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="撤销" Click="BtnUndo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="撤销" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="重做" Click="BtnRedo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↪" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="重做" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="版本管理" Click="BtnVersionManager_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕘" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="版本" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="选择要素" Click="BtnSelect_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖱" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="选择" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="图层管理" Click="BtnLayerManager_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗺" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="图层" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <!-- 登录按钮（靠右独立摆放） -->
                <Border Grid.Column="1" BorderBrush="#30363D" BorderThickness="1,0,0,0" Padding="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnLoginToolbar" Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="登录" Click="BtnCloudSync_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtLoginIcon" Text="🔑" FontFamily="Segoe UI Symbol" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLoginLabel" Text="登录" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                    </Grid>
                </Border>
        </Border>

        <!-- ========== 主区域 ========== -->
        <Grid x:Name="MainGrid" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="LayerManagerColumn" Width="0"/>
                <ColumnDefinition x:Name="RightColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧：模块导航 ========== -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource PanelHeaderStyle}" Text="模块导航"/>

                    <!-- 图层管理按钮（统一分组） -->
                    <RadioButton x:Name="BtnLayerManager" 
                                 Style="{StaticResource ModuleButtonStyle}" 
                                 Click="BtnLayerManager_Click" 
                                 GroupName="NavGroup">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModuleIconStyle}">
                                <TextBlock Text="📁" FontFamily="Segoe UI Symbol" Foreground="#3FB950" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="图层管理" Style="{StaticResource ModuleTitleStyle}"/>
                                <TextBlock Text="图层显示与管理" Style="{StaticResource ModuleSubStyle}"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="BtnDataEdit" 
                                 Style="{StaticResource ModuleButtonStyle}" 
                                 Click="BtnDataEdit_Click" 
                                 IsChecked="True" 
                                 GroupName="NavGroup">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModuleIconStyle}">
                                <TextBlock Text="✏" FontFamily="Segoe UI Symbol" Foreground="#3FB950" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="数据编辑" Style="{StaticResource ModuleTitleStyle}"/>
                                <TextBlock Text="地质空间数据编辑模块" Style="{StaticResource ModuleSubStyle}"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="BtnMapCompile" 
                                 Style="{StaticResource ModuleButtonStyle}" 
                                 Click="BtnMapCompile_Click" 
                                 GroupName="NavGroup">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModuleIconStyle}">
                                <TextBlock Text="🗺" FontFamily="Segoe UI Symbol" Foreground="#3FB950" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="图件编绘" Style="{StaticResource ModuleTitleStyle}"/>
                                <TextBlock Text="地质图编绘模块" Style="{StaticResource ModuleSubStyle}"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="BtnFieldData" 
                                 Style="{StaticResource ModuleButtonStyle}" 
                                 Click="BtnFieldData_Click" 
                                 GroupName="NavGroup">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModuleIconStyle}">
                                <TextBlock Text="📊" FontFamily="Segoe UI Symbol" Foreground="#3FB950" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="野外数据" Style="{StaticResource ModuleTitleStyle}"/>
                                <TextBlock Text="野外数据接收与整理" Style="{StaticResource ModuleSubStyle}"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                </StackPanel>
            </Border>

            <!-- ========== 中间：地图标签页 ========== -->
            <Grid Grid.Column="1" Background="#0D1117">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,0.5">
                    <TabControl x:Name="MapTabControl" Background="White" SelectionChanged="MapTabControl_SelectionChanged">
                        <!-- 标签页 1：地图视图 -->
                        <TabItem Header="地图视图">
                            <Grid>
                                <esri:MapView x:Name="MapView1" Background="White">
                                    <esri:MapView.ContextMenu>
                                        <ContextMenu x:Name="MapContextMenu">
                                            <MenuItem Header="保存编辑" Click="MenuItem_SaveEdit_Click"/>
                                            <MenuItem Header="撤回到上一步" Click="MenuItem_Undo_Click"/>
                                            <MenuItem Header="撤回所有更改" Click="MenuItem_UndoAll_Click"/>
                                            <Separator/>

                                        </ContextMenu>
                                    </esri:MapView.ContextMenu>
                                 </esri:MapView>
                                <Image x:Name="MapView1ImageOverlay"
                                       Stretch="Fill"
                                       Panel.ZIndex="50"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="12">
                                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Padding="10,6" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="📍 坐标:" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#8B949E"/>
                                                <TextBox x:Name="TxtCoordinate" Width="240" FontSize="12" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#E6EDF3"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <!-- 标签页 2：数据视图 -->
                        <TabItem Header="数据视图">
                            <Grid>
                                <esri:MapView x:Name="MapView2" Background="White" />
                                <Image x:Name="UnreferencedImageOverlay"
                                       Stretch="Fill"
                                       Panel.ZIndex="50"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False"/>
                                <Canvas x:Name="GeorefCanvas" Panel.ZIndex="60" IsHitTestVisible="False"/>
                                <Canvas x:Name="CrosshairCanvas" Panel.ZIndex="100" IsHitTestVisible="False"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="12">
                                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Padding="10,6" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="📍 坐标:" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#8B949E"/>
                                                <TextBox x:Name="TxtCoordinate2" Width="240" FontSize="12" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#E6EDF3"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <!-- ========== 右侧：图层管理器 ========== -->
            <Border Grid.Column="2" 
                    x:Name="LayerManagerBorder"
                    Background="#161B22" 
                    BorderBrush="#30363D" 
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="图层管理" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Content="✕" 
                                    Width="24" 
                                    Height="24"
                                    FontSize="12"
                                    Foreground="#8B949E"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="BtnCloseLayerManager_Click"
                                    ToolTip="关闭图层管理器">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#F85149"/>
                                                <Setter Property="Background" Value="#30363D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    <local:LayerManagerPanel Grid.Row="1" x:Name="LayerManager"/>
                </Grid>
            </Border>

            <!-- ========== 右侧：模块面板（默认隐藏） ========== -->
            <Border Grid.Column="3" 
                    x:Name="RightPanelBorder"
                    Background="#161B22" 
                    BorderBrush="#30363D" 
                    BorderThickness="1,0,0,0"
                    HorizontalAlignment="Right"
                    MaxWidth="380"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnBackModule"
                                    Content="←" 
                                    Width="24" 
                                    Height="24"
                                    FontSize="14"
                                    Foreground="#E6EDF3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="BtnBackModule_Click"
                                    ToolTip="返回上一级"
                                    Visibility="Collapsed">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#3FB950"/>
                                                <Setter Property="Background" Value="#30363D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Grid.Column="1" x:Name="ModuleTitle" Text="数据编辑" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" 
                                    Content="✕" 
                                    Width="24" 
                                    Height="24"
                                    FontSize="12"
                                    Foreground="#8B949E"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="BtnCloseModulePanel_Click"
                                    ToolTip="关闭模块面板">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#F85149"/>
                                                <Setter Property="Background" Value="#30363D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="ModulePanel" Margin="0">
                            <local:DataEditPanel x:Name="PanelDataEdit" />
                            <local:FieldDataPanel x:Name="PanelFieldData" Visibility="Collapsed"/>
                            <local:TopologyCheckPanel x:Name="PanelTopologyCheck" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 状态栏 ========== -->
        <Border x:Name="StatusBarBorder" Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="#30363D" BorderThickness="1,0,0,0" Background="#0D1117" Padding="8,6">
            <TextBlock x:Name="StatusBar" Text="就绪" FontSize="12" Foreground="#8B949E"/>
        </Border>
    </Grid>
</Window>