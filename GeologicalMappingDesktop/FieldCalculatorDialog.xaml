<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GeologicalMappingDesktop.FieldCalculatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字段计算器" Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <ToggleButton x:Name="toggleButton" 
                                                  Grid.Column="2" 
                                                  Focusable="false"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" Padding="8">
                                                    <Path x:Name="Arrow" 
                                                          Fill="#8B8B8B"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M0 0 L3 3 L6 0 Z"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="contentPresenter"
                                                      IsHitTestVisible="False" 
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#2D2D2D"
                                        BorderBrush="#454545"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="2"
                                        MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3C3C3C"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#454545"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FunctionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CDCFE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3C3C3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="#2D2D2D" CornerRadius="4" Padding="10" Margin="0,0,8,8">
            <StackPanel>
                <TextBlock Text="目标字段" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CboTargetField" 
                          Style="{StaticResource ComboBoxStyle}"
                          Margin="0,0,0,0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}"/>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="#2D2D2D" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="计算表达式" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtExpression" 
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="80"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Background="#252526" CornerRadius="4" Padding="8" Margin="0,0,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="字段" Foreground="#8B8B8B" FontSize="11" Margin="0,0,0,4"/>
                <ListBox x:Name="FieldList" Grid.Row="1" 
                         Background="#1E1E1E"
                         Foreground="#FFFFFF"
                         BorderBrush="#3C3C3C"
                         BorderThickness="1"
                         SelectionMode="Single"
                         Margin="0,0,0,8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Background" Value="#1E1E1E"/>
                            <Setter Property="Foreground" Value="#9CDCFE"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#007ACC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Text="函数" Foreground="#8B8B8B" FontSize="11" Margin="0,0,0,4"/>
                <ListBox x:Name="FunctionList" Grid.Row="3" 
                         Background="#1E1E1E"
                         Foreground="#FFFFFF"
                         BorderBrush="#3C3C3C"
                         BorderThickness="1"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Background" Value="#1E1E1E"/>
                            <Setter Property="Foreground" Value="#DCDCAA"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#007ACC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" Background="#2D2D2D" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="运算符" Foreground="#8B8B8B" FontSize="11" Margin="0,0,0,6"/>
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButtonStyle}" Content="+" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="-" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="*" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="/" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="(" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content=")" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&amp;" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="=" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&gt;" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&lt;" Click="BtnOperator_Click" Width="40"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&gt;=" Click="BtnOperator_Click" Width="50"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&lt;=" Click="BtnOperator_Click" Width="50"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="!=" Click="BtnOperator_Click" Width="40"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="2" Background="#252526" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="常用数学函数" Foreground="#8B8B8B" FontSize="11" Margin="0,0,0,6"/>
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Abs()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Sqrt()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Round()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Ceiling()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Floor()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Sin()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Cos()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Tan()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Log()" Click="BtnFunction_Click"/>
                    <Button Style="{StaticResource FunctionButtonStyle}" Content="Exp()" Click="BtnFunction_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消" Width="80" Height="30" Margin="0,0,10,0"
                    Click="BtnCancel_Click"
                    Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#454545" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#454545"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="BtnExecute" Content="确定" Width="80" Height="30"
                    Click="BtnExecute_Click"
                    Background="#007ACC" Foreground="White" BorderBrush="#007ACC" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A86D9"/>
                                <Setter Property="BorderBrush" Value="#1A86D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#6E7681"/>
                                <Setter Property="BorderBrush" Value="#6E7681"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>