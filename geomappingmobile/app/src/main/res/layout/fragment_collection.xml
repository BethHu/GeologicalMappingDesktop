<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/dark_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/collection_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewPoint"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/collection_new_point"
            android:textSize="12sp"
            app:icon="@drawable/ic_add"
            app:iconSize="16dp"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@drawable/gradient_glow_line"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/filterScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:background="@color/surface_card"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/filterChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAll"
                style="@style/FilterChipButton"
                android:text="@string/collection_filter_all"
                android:checked="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipGeological"
                style="@style/FilterChipButton"
                android:text="@string/point_geological" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipStructural"
                style="@style/FilterChipButton"
                android:text="@string/point_structural" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipSample"
                style="@style/FilterChipButton"
                android:text="@string/point_sample" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipPhoto"
                style="@style/FilterChipButton"
                android:text="@string/point_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipLandform"
                style="@style/FilterChipButton"
                android:text="@string/point_landform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipHydrological"
                style="@style/FilterChipButton"
                android:text="@string/point_hydrological" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipEngineering"
                style="@style/FilterChipButton"
                android:text="@string/point_engineering" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/searchSortCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/filterScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.5"
                    android:contentDescription="搜索"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:background="@null"
                    android:hint="搜索描述或编号..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.5"
                    android:background="@null"
                    android:contentDescription="清除搜索"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/dark_border" />

            <LinearLayout
                android:id="@+id/sortChipContainer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="排序:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortTimeNewest"
                    style="@style/FilterChipButton"
                    android:checked="true"
                    android:text="最新优先" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortTimeOldest"
                    style="@style/FilterChipButton"
                    android:text="最旧优先" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortByType"
                    style="@style/FilterChipButton"
                    android:text="按类型" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pointRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchSortCard" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collection_no_points"
        android:textColor="@color/text_disabled"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchSortCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
