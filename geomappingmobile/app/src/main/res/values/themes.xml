<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.GeoMappingMobile" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- Surface -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/dark_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/dark_border</item>
        <item name="colorOutlineVariant">@color/dark_border</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
    </style>

    <style name="Theme.GeoMappingMobile" parent="Base.Theme.GeoMappingMobile" />

    <style name="GeoCard">
        <item name="cardBackgroundColor">@color/dark_card</item>
        <item name="strokeColor">@color/dark_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="GeoButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="GeoButtonOutline">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/dark_border</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="GeoFilterChip">
        <item name="chipBackgroundColor">@color/dark_card</item>
        <item name="chipStrokeColor">@color/dark_border</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="FilterChipButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="backgroundTint">@color/dark_card</item>
        <item name="strokeColor">@color/dark_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:checkable">true</item>
    </style>

    <style name="NavBarText">
        <item name="android:textSize">10sp</item>
    </style>
</resources>
